+    with pytest.raises(ValueError, match=rf"thermal\.{key} must be > 0"):
+        _params(_with_thermal(**{key: bad}))
+
+
+@pytest.mark.parametrize("key", _RATE_KEYS)
+def test_rate_scale_stability_bound(key):
+    # k_exchange + k_loss = 0.05 in the campfire world, so 20 is the largest legal scale.
+    _params(_with_thermal(**{key: 20.0}))
+    with pytest.raises(ValueError, match=rf"thermal\.{key} \* \(thermal\.k_exchange"):
+        _params(_with_thermal(**{key: 20.5}))
+
+
+def test_rate_scale_keys_not_required_when_thermal_is_off():
