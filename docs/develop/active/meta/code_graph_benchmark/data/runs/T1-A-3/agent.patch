diff --git a/tests/env/test_thermal_body.py b/tests/env/test_thermal_body.py
index 2b13506..4b79f6e 100644
--- a/tests/env/test_thermal_body.py
+++ b/tests/env/test_thermal_body.py
@@ -341,3 +341,66 @@ def test_body_temp_is_inert_when_thermal_is_off():
         assert int(info["termination_reason"]) != 5, "reason 5 on a thermal-off config"
         if bool(done):
             break
+
+
+# ── warming / cooling speed ──────────────────────────────────────────────────
+
+def _scaled_config(cell, warming, cooling, max_steps=800):
+    d = _uniform_field_config(cell, max_steps=max_steps)
+    d["thermal"]["warming_rate_scale"] = warming
+    d["thermal"]["cooling_rate_scale"] = cooling
+    return d
+
+
+def _scaled_oracle(cell, n, k_ex, k_loss, k_met, t_set, warming, cooling, t0):
+    """numpy loop: the whole step d is scaled by the warming or cooling factor."""
+    T, out = t0, [t0]
+    for _ in range(n):
+        d = k_ex * (cell - T) + k_met - k_loss * (T - t_set)
+        T = T + (warming if d > 0 else cooling) * d
+        out.append(T)
+    return np.array(out)
+
+
+def test_rate_scales_default_to_the_unscaled_path():
+    params = _params(_uniform_field_config(-10.0))
+    assert params.thermal_warming_rate_scale == 1.0
+    assert params.thermal_cooling_rate_scale == 1.0
+
+
+@pytest.mark.parametrize("cell,warming,cooling", [
+    (-10.0, 1.0, 0.5),    # cold cell: d < 0 all along, only the cooling scale acts
+    (10.0, 0.5, 1.0),     # hot cell: d > 0 all along, only the warming scale acts
+    (-10.0, 0.5, 0.5),    # equal but != 1.0 is a uniform speed change, not today's
+    (10.0, 2.0, 3.0),
+])
+def test_rate_scales_scale_the_whole_step_and_keep_the_fixed_point(cell, warming, cooling):
+    params = _params(_scaled_config(cell, warming, cooling))
+    k_ex, k_loss = float(params.thermal_k_exchange), float(params.thermal_k_loss)
+    k_met, t_set = float(params.thermal_k_metabolic), float(params.temperature_setpoint)
+
+    traj, _, reason, n_steps, _, _ = _rollout(params, 600)
+    assert reason == 0 and n_steps == 600
+    oracle = _scaled_oracle(cell, 600, k_ex, k_loss, k_met, t_set, warming, cooling,
+                            float(traj[0]))
+    np.testing.assert_allclose(traj, oracle, atol=2e-4)
+    # Same settling temperature as the unscaled recurrence.
+    t_star = (k_ex * cell + k_loss * t_set + k_met) / (k_ex + k_loss)
+    assert traj[-1] == pytest.approx(t_star, abs=1e-3)
+
+
+def test_rate_scale_uses_the_sign_of_the_whole_step():
+    """Start warmer than the fixed point in a cold cell: d < 0 -> cooling scale;
+    start colder than it: d > 0 -> warming scale. Exercises both branches of one
+    trajectory rather than one scale per world."""
+    params = _params(_scaled_config(-10.0, 0.25, 0.75))
+    k_ex, k_loss = float(params.thermal_k_exchange), float(params.thermal_k_loss)
+    t_set = float(params.temperature_setpoint)
+    state = jax_reset(params, jax.random.PRNGKey(0))
+    for t0 in (5.0, -12.0):        # T* = -8; above it d < 0, below it d > 0
+        s = state.replace(body_temp=jnp.float32(t0))
+        cell = float(s.thermal_field[s.agent_pos[0], s.agent_pos[1]])
+        d = k_ex * (cell - t0) - k_loss * (t0 - t_set)
+        scale = 0.75 if d < 0 else 0.25
+        s2, _, _, _ = jax_step(s, REST, params)
+        assert float(s2.body_temp) == pytest.approx(t0 + scale * d, abs=1e-4)
