+        "assert 'matplotlib' not in sys.modules\n"
+        "assert len(map_plan('Visual', ('GRS','SND','PLN','FOD','HPR','PRD','RCK','NEU'))) == 6\n"
+        "assert len(map_plan('Visual', tuple(f'C{i}' for i in range(4)))) == 4\n"
+    )
+    subprocess.run([sys.executable, "-c", code], cwd=_ROOT, check=True)
