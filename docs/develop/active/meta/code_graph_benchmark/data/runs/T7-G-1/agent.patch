diff --git a/tests/env/test_dashboard_layout.py b/tests/env/test_dashboard_layout.py
index 7fa4b8f..2f72210 100644
--- a/tests/env/test_dashboard_layout.py
+++ b/tests/env/test_dashboard_layout.py
@@ -748,3 +748,82 @@ def test_the_channel_row_heights_agree_with_the_painter_that_draws_them():
         assert 64 + per_col * PN.CHANNEL_ROW_PITCH[sense] + 16 == pinned, (
             f"{key}: {per_col} rows at {PN.CHANNEL_ROW_PITCH[sense]}px no longer "
             f"makes the pinned {pinned}px")
+
+
+_SENSES = (
+    ("Olfaction", "Olfaction", 5, "olfactory_range", P._olf_min_size, "OLF_STOPS"),
+    ("Visual", "Vision", 8, "visual_range", P._visual_min_size, "VIS_STOPS"),
+)
+
+
+@pytest.mark.parametrize("r", [1, 2, 3])
+@pytest.mark.parametrize("sense,title,n_ch,field,min_size,stops", _SENSES)
+def test_a_sense_panel_declares_exactly_the_width_the_painter_needs(
+        sense, title, n_ch, field, min_size, stops, r):
+    """The declared width draws, and one pixel less is refused.
+
+    Pins the three counts that used to disagree: vision's 8 channels draw 6 maps,
+    the gap is ``MAP_GAP_PX`` in both places, and the card padding is added.
+    """
+    import dataclasses
+
+    import matplotlib
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+
+    from src.environment.dashboard import painters as PN
+    from src.environment.dashboard.labels import channel_labels
+    from src.environment.sensor import get_visual_offsets
+
+    assert PN.MAP_GAP == P.MAP_GAP_PX
+
+    class _Text:
+        def set(self, s):
+            return 10.0
+
+    class _Dash:
+        sense_max: dict = {}
+        updates: list = []
+
+        def viz_name(self, s):
+            return s
+
+        def fit(self, *a, **k):
+            return _Text()
+
+        def width(self, *a, **k):
+            return 10.0
+
+    ctx = dataclasses.replace(
+        LayoutContext(world_w=10, world_h=10, local_view_size=5, breakdown={},
+                      thermal=False, intero_noc_enabled=False),
+        **{field: r},
+    )
+    declared = min_size(ctx).w
+    codes = channel_labels(sense, n_ch)
+    offs = [tuple(o) for o in get_visual_offsets(r)]
+
+    def paint(width):
+        fig, ax = plt.subplots()
+        ax._px_w, ax._px_h = width, 400
+        try:
+            PN.build_channel_maps(_Dash(), ax, 0, width - 2 * PN.PAD, 400, sense,
+                                  title, codes, getattr(PN.P, stops), offs, r)
+        finally:
+            plt.close(fig)
+
+    paint(declared)
+    with pytest.raises(LayoutOverflowError):
+        paint(declared - 1)
+
+
+def test_the_registry_counts_maps_through_map_plan_without_matplotlib():
+    code = (
