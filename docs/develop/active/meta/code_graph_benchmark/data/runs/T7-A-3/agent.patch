@@ -748,3 +748,97 @@ def test_the_channel_row_heights_agree_with_the_painter_that_draws_them():
         assert 64 + per_col * PN.CHANNEL_ROW_PITCH[sense] + 16 == pinned, (
             f"{key}: {per_col} rows at {PN.CHANNEL_ROW_PITCH[sense]}px no longer "
             f"makes the pinned {pinned}px")
+
+
+# --------------------------------------------------------------------------
+# A sense panel declares exactly the width its painter needs
+# --------------------------------------------------------------------------
+class _StubDash:
+    """Just enough of the dashboard for `build_channel_maps` to run."""
+
+    sense_max: dict = {}
+
+    def __init__(self):
+        self.updates = []
+
+    def viz_name(self, sense):
+        return sense
+
+    def width(self, text, kind):
+        return 1.0
+
+    def fit(self, *args, **kwargs):
+        class _Setter:
+            def set(self, _text):
+                return 1.0
+        return _Setter()
+
+
+def _paint_maps(sense, title, n_channels, rng, card_w, band_h=400):
+    import matplotlib
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+    from src.environment.dashboard import labels as LB
+    from src.environment.dashboard import painters as PN
+    from src.environment.dashboard import palette as PAL
+    from src.environment.sensor import get_visual_offsets
+
+    codes = LB.channel_labels(sense, n_channels)
+    offs = [tuple(o) for o in get_visual_offsets(rng)]
+    fig, ax = plt.subplots()
+    ax._px_w, ax._px_h = card_w, band_h   # what the painter's Axes factory sets
+    try:
+        PN.build_channel_maps(
+            _StubDash(), ax, 0, card_w - 2 * PN.PAD, band_h, sense, title, codes,
+            PAL.OLF_STOPS if sense == "Olfaction" else PAL.VIS_STOPS, offs, rng,
+        )
+    finally:
+        plt.close(fig)
+
+
+@pytest.mark.parametrize("rng", [1, 2, 3])
+@pytest.mark.parametrize(
+    "sense,title,n_channels,field",
+    [
+        ("Olfaction", "Olfaction", 5, "olfactory_channels"),
+        ("Visual", "Vision", 8, "visual_vector_size"),
+        ("Visual", "Vision", 5, "visual_vector_size"),   # off-standard: one map per channel
+    ],
+)
+def test_declared_sense_width_is_exactly_what_the_painter_needs(
+    sense, title, n_channels, field, rng
+):
+    import dataclasses
+
+    key = "olfactory" if sense == "Olfaction" else "visual"
+    range_field = "olfactory_range" if sense == "Olfaction" else "visual_range"
+    ctx = dataclasses.replace(_synthetic(10), **{field: n_channels, range_field: rng})
+    spec = next(p for p in P.PANELS if p.key == key)
+    declared = spec.min_size(ctx).w
+
+    _paint_maps(sense, title, n_channels, rng, declared)            # draws
+    with pytest.raises(LayoutOverflowError):
+        _paint_maps(sense, title, n_channels, rng, declared - 1)    # refuses
+
+
+def test_the_known_widths_at_range_three_and_one():
+    ctx = _synthetic(10)
+    import dataclasses
+    vis = next(p for p in P.PANELS if p.key == "visual")
+    olf = next(p for p in P.PANELS if p.key == "olfactory")
+    assert vis.min_size(dataclasses.replace(ctx, visual_range=3)).w == 482
+    assert olf.min_size(dataclasses.replace(ctx, olfactory_range=1)).w == 206
+
+
+def test_the_map_gap_is_one_constant():
+    from src.environment.dashboard import painters as PN
+
+    assert PN.MAP_GAP == P.MAP_GAP_PX
+
+
+def test_map_plan_is_importable_from_the_painter_module_and_counts_six_for_vision():
+    from src.environment.dashboard import labels as LB
+    from src.environment.dashboard import painters as PN
+
