diff --git a/tests/env/test_dashboard_layout.py b/tests/env/test_dashboard_layout.py
index 7fa4b8f..1061fa7 100644
--- a/tests/env/test_dashboard_layout.py
+++ b/tests/env/test_dashboard_layout.py
@@ -748,3 +748,28 @@ def test_the_channel_row_heights_agree_with_the_painter_that_draws_them():
         assert 64 + per_col * PN.CHANNEL_ROW_PITCH[sense] + 16 == pinned, (
             f"{key}: {per_col} rows at {PN.CHANNEL_ROW_PITCH[sense]}px no longer "
             f"makes the pinned {pinned}px")
+
+
+# -- a sense panel declares exactly the width its painter needs ------------------
+@pytest.mark.parametrize("sense,expected", [
+    ("olfactory", {1: 206, 2: 306, 3: 406}),
+    ("visual", {1: 242, 2: 362, 3: 482}),
+])
+def test_sense_panel_declared_width_is_the_painters_real_requirement(sense, expected):
+    """5 olfactory maps / 6 visual maps (terrain is one), 6 px gap, 2 * PAD card padding."""
+    spec = next(p for p in P.PANELS if p.key == sense)
+    for r, width in expected.items():
+        ctx = LayoutContext(world_w=10, world_h=10, local_view_size=5, breakdown={},
+                            thermal=False, intero_noc_enabled=False,
+                            olfactory_range=r, visual_range=r)
+        assert spec.min_size(ctx).w == width
+
+
+def test_map_plan_is_shared_between_registry_and_painter():
+    from src.environment.dashboard import labels
+    from src.environment.dashboard import painters
+    assert painters.map_plan is labels.map_plan
+    assert painters.MAP_GAP == P.MAP_GAP_PX
+    # an off-standard vector width gets one map per channel, no terrain composite
+    assert len(labels.map_plan("Visual", labels.visual_labels(10))) == 10
+    assert len(labels.map_plan("Visual", labels.visual_labels(8))) == 6
