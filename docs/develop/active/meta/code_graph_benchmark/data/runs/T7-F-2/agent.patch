+
+
+def test_map_width_constants_are_one_and_map_plan_needs_no_matplotlib():
+    from src.environment.dashboard import labels
+
+    assert P.map_plan is labels.map_plan
+    assert P.MAP_GAP_PX == 6
+    assert len(labels.map_plan("Visual", labels.visual_labels(8))) == 6
+    assert len(labels.map_plan("Visual", labels.visual_labels(7))) == 7
+
+
+@pytest.mark.parametrize("r", [1, 2, 3])
+def test_a_sense_card_declares_exactly_the_width_its_painter_needs(r):
+    """The card asks for the maps' width plus the padding the painter is handed off."""
+    pytest.importorskip("matplotlib")
+    import matplotlib
+
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+
+    from src.environment.dashboard import painters as PN
+    from src.environment.dashboard.labels import olfactory_labels, visual_labels
+    from src.environment.sensor import get_visual_offsets
+
+    class _Dash:
+        sense_max: dict = {}
+
+        def __init__(self):
+            self.updates = []
+
+        def viz_name(self, name):
+            return name
+
+        def width(self, s, role):
+            return 1.0
+
+        def fit(self, ax, x, y, role, max_w, numeric=True, **kw):
+            class _F:
+                def set(self, s):
+                    return 1.0
+            return _F()
+
+    def draw(sense, codes, w):
+        fig, ax = plt.subplots()
+        ax._px_w, ax._px_h = w, 300
+        ax.set_xlim(0, w)
+        ax.set_ylim(300, 0)
+        offs = [tuple(o) for o in get_visual_offsets(r)]
+        try:
+            PN.build_channel_maps(_Dash(), ax, PN.PAD, w, 300, sense, sense, codes,
+                                  ["#ffffff", "#000000"], offs, r)
+        finally:
+            plt.close(fig)
+
+    ctx = _synthetic(olf_range=r, vis_range=r, visual_present=True)
+    for sense, codes, size in (
+        ("Olfaction", olfactory_labels(5), P._olf_min_size(ctx)),
+        ("Visual", visual_labels(8), P._visual_min_size(ctx)),
+    ):
+        w = size.w - 2 * PN.PAD
+        draw(sense, codes, w)
+        with pytest.raises(LayoutOverflowError):
+            draw(sense, codes, w - 1)
