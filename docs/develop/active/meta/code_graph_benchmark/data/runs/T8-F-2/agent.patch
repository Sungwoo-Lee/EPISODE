diff --git a/tests/models/test_return_mode_cross.py b/tests/models/test_return_mode_cross.py
new file mode 100644
index 0000000..4b89625
--- /dev/null
+++ b/tests/models/test_return_mode_cross.py
@@ -0,0 +1,99 @@
+"""Tests for the GAE_NORM and MC_RAW return modes of recurrent PPO.
+
+Plain-language context: the trainer already had "MC" / "MC_FIXED" (Monte-Carlo returns) and
+"GAE" (generalised advantage estimation). Two more modes complete the cross of *return
+estimator* against *scaling convention*:
+
+  - "GAE_NORM": the GAE estimator, but with MC's normalisation — the critic target
+    (`advantage + V`) is z-scored and the advantage is the un-rescaled `target - V`.
+  - "MC_RAW": the MC_FIXED returns with no normalisation at all — raw critic target AND
+    raw advantage.
+"""
+import jax
+import jax.numpy as jnp
+import pytest
+
+from src.models import recurrent_ppo_trainer as rpt
+from src.models.recurrent_ppo_trainer import LEGAL_RETURN_MODES, compute_gae, validate_return_mode
+
+from tests.models.test_mc_fixed_mode import (  # noqa: F401  (tiny_env_and_model is a fixture)
+    GAMMA, _Cfg, _capture_batch, _expected_returns, tiny_env_and_model,
+)
+
+
+def test_legal_return_modes_order():
+    assert LEGAL_RETURN_MODES == ("MC", "MC_FIXED", "GAE", "GAE_NORM", "MC_RAW")
+
+
+@pytest.mark.parametrize("given,canonical", [
+    ("gae_norm", "GAE_NORM"), ("GAE_NORM", "GAE_NORM"), (" Gae_Norm ", "GAE_NORM"),
+    ("mc_raw", "MC_RAW"), ("MC_RAW", "MC_RAW"), ("Mc_Raw", "MC_RAW"),
+])
+def test_new_modes_accepted_case_insensitively(given, canonical):
+    assert validate_return_mode(given) == canonical
+
+
+def test_error_message_names_every_legal_mode(monkeypatch):
+    with pytest.raises(ValueError) as exc:
+        validate_return_mode("TD")
+    for legal in LEGAL_RETURN_MODES:
+        assert legal in str(exc.value)
+    with pytest.raises(ValueError) as exc:
+        _capture_batch("NOPE", monkeypatch)
+    for legal in LEGAL_RETURN_MODES:
+        assert legal in str(exc.value)
+
+
+def test_mc_raw_raw_target_and_raw_advantage(monkeypatch):
+    batch, collect_mode, traj, boot = _capture_batch("MC_RAW", monkeypatch)
+    expected = _expected_returns(traj, boot)
+    assert collect_mode == "MC_RAW"
+    assert jnp.allclose(batch.targets, expected, atol=1e-6)
+    assert jnp.allclose(batch.advantages, expected - traj.value, atol=1e-6)
+    assert abs(float(jnp.std(batch.advantages)) - 1.0) > 1e-3
+
+
+def test_mc_raw_targets_equal_mc_fixed_targets(monkeypatch):
+    raw, _, _, _ = _capture_batch("MC_RAW", monkeypatch)
+    fixed, _, _, _ = _capture_batch("MC_FIXED", monkeypatch)
+    assert jnp.array_equal(raw.targets, fixed.targets)
+
+
+def test_gae_norm_zscored_target_and_unrescaled_advantage(monkeypatch):
+    batch, collect_mode, traj, _ = _capture_batch("GAE_NORM", monkeypatch)
+    assert collect_mode == "GAE_NORM"
+    terminateds = (traj.step_info.termination_reason >= 2).astype(traj.done.dtype)
+    gae = jax.vmap(compute_gae, in_axes=(1, 1, 1, 1, 1, None, None), out_axes=1)(
+        traj.reward, traj.value, traj.next_value, traj.done, terminateds, GAMMA, _Cfg.gae_lambda)
+    raw_target = gae + traj.value
+    expected_target = (raw_target - jnp.mean(raw_target)) / (jnp.std(raw_target) + 1e-7)
+    assert jnp.allclose(batch.targets, expected_target, atol=1e-5)
+    assert jnp.allclose(batch.advantages, batch.targets - traj.value, atol=1e-6)
+    assert float(jnp.mean(batch.targets)) == pytest.approx(0.0, abs=1e-5)
+    assert float(jnp.std(batch.targets)) == pytest.approx(1.0, abs=1e-4)
+    assert abs(float(jnp.std(batch.advantages)) - 1.0) > 1e-3
+
+
+@pytest.mark.integration
+@pytest.mark.parametrize("mode,expect_per_step_next_value", [
+    ("GAE_NORM", True), ("MC_RAW", False),
+])
+def test_bootstrap_path_selection(mode, expect_per_step_next_value, tiny_env_and_model):
+    model, params, state = tiny_env_and_model
+    h = model.initial_state(2)
+    traj, _, _, _, _, bootstrap_value = rpt.collect_trajectories(
+        model, params, state, h, jax.random.PRNGKey(3), 4,
+        rnn_type="GRU", return_mode=mode)
+    assert bool(jnp.any(traj.next_value != 0.0)) == expect_per_step_next_value
+    assert bootstrap_value.shape == (2,)
+
+
+@pytest.mark.parametrize("mode", ["GAE_NORM", "MC_RAW", "gae_norm", "mc_raw"])
+def test_plain_ppo_rejects_new_modes(mode):
+    from src.models.ppo_trainer import train_iteration_ppo
+
+    class Cfg:
+        return_mode = mode
+
+    with pytest.raises(ValueError, match=mode):
+        train_iteration_ppo(None, None, None, None, None, Cfg())
