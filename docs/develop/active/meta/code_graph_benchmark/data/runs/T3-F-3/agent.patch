+# ------------------------------------------- conditional-mandatory blur knobs ---
+
+_BLUR_KNOBS = ('visual_blur_radial_scale', 'visual_blur_anisotropy', 'visual_blur_sigma_floor')
+
+
+def _blur_config(enabled, drop=(), **overrides):
+    c = Config.load_yaml(DEFAULT)
+    c.set('sensory.visual_blur_enabled', enabled)
+    for k, v in overrides.items():
+        c.set(k, v)
+    for k in drop:
+        del c.to_dict()['sensory'][k]
+    return c
+
+
+def test_blur_off_loads_without_the_knobs():
+    p = load_env_params(_blur_config(False, drop=_BLUR_KNOBS))
+    assert p.visual_blur_enabled is False
+    for f in ('visual_blur_radial_scale', 'visual_blur_anisotropy', 'visual_blur_sigma_floor'):
+        assert np.isfinite(float(getattr(p, f)))
+
+
+@pytest.mark.parametrize('knob', _BLUR_KNOBS)
+def test_blur_on_missing_knob_raises_naming_it(knob):
+    with pytest.raises(ValueError, match=knob):
+        load_env_params(_blur_config(True, drop=(knob,)))
+
+
+@pytest.mark.parametrize('overrides,knob', [
+    ({'sensory.visual_blur_anisotropy': 0.0}, 'visual_blur_anisotropy'),
+    ({'sensory.visual_blur_sigma_floor': 0.0,
+      'sensory.visual_blur_radial_scale': 0.0}, 'visual_blur_sigma_floor'),
+    ({'sensory.visual_blur_radial_scale': -0.1}, 'visual_blur_radial_scale'),
+])
+def test_blur_on_value_checks_still_fire(overrides, knob):
+    with pytest.raises(ValueError, match=knob):
+        load_env_params(_blur_config(True, **overrides))
+
+
