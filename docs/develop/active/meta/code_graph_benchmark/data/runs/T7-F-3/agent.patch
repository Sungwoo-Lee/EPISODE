diff --git a/tests/env/test_dashboard_layout.py b/tests/env/test_dashboard_layout.py
index 7fa4b8f..473c24a 100644
--- a/tests/env/test_dashboard_layout.py
+++ b/tests/env/test_dashboard_layout.py
@@ -748,3 +748,70 @@ def test_the_channel_row_heights_agree_with_the_painter_that_draws_them():
         assert 64 + per_col * PN.CHANNEL_ROW_PITCH[sense] + 16 == pinned, (
             f"{key}: {per_col} rows at {PN.CHANNEL_ROW_PITCH[sense]}px no longer "
             f"makes the pinned {pinned}px")
+
+
+@pytest.mark.parametrize("sense,key,n_codes", [
+    ("Olfaction", "olfactory", 5),
+    ("Visual", "visual", 8),
+    ("Visual", "visual", 5),     # off-standard width: one map per channel
+])
+@pytest.mark.parametrize("r", [1, 2, 3])
+def test_a_sense_panel_declares_exactly_the_width_its_painter_needs(sense, key, n_codes, r):
+    """The declared minimum equals the painter's real requirement, to the pixel.
+
+    The painter is handed the card width minus 2*PAD, so the declaration must add
+    the padding back; it must count maps the way `map_plan` does (vision's three
+    terrain channels are ONE map); and the gap must be the one constant the
+    painter imports. Drawing at the declared width succeeds, one pixel less raises.
+    """
+    import matplotlib
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+    from src.environment.dashboard import painters as PN
+    from src.environment.dashboard.labels import olfactory_labels, visual_labels, map_plan
+    from src.environment.sensor import get_visual_offsets
+
+    assert PN.MAP_GAP is P.MAP_GAP_PX and PN.map_plan is map_plan
+    codes = olfactory_labels(n_codes) if sense == "Olfaction" else visual_labels(n_codes)
+    ctx = LayoutContext(
+        world_w=10, world_h=10, local_view_size=5, breakdown={}, thermal=False,
+        intero_noc_enabled=False, olfactory_range=r, visual_range=r,
+        visual_vector_size=n_codes, olfactory_channels=n_codes)
+    spec = next(p for p in P.PANELS if p.key == key)
+    declared = spec.min_size(ctx).w
+    n_maps = len(map_plan(sense, codes))
+    assert declared == (n_maps * (2 * r + 1) * P.MAP_CELL_MIN_PX
+                        + P.MAP_GAP_PX * (n_maps - 1) + 2 * L.PAD)
+
+    class _Text:
+        def set(self, *_a, **_k):
+            return 10
+
+    class _Dash:
+        sense_max: dict = {}
+        updates: list = []
+
+        def viz_name(self, name):
+            return name
+
+        def fit(self, *_a, **_k):
+            return _Text()
+
+        def width(self, *_a, **_k):
+            return 10
+
+    def draw(w):
+        fig, ax = plt.subplots()
+        ax.set_xlim(0, 1000)
+        ax.set_ylim(0, 1000)
+        ax._px_w, ax._px_h = 1000, 1000
+        offs = [tuple(o) for o in get_visual_offsets(r)]
+        try:
+            PN.build_channel_maps(_Dash(), ax, 0, w, 400, sense, sense, codes,
+                                  ("#000000", "#ffffff"), offs, r)
+        finally:
+            plt.close(fig)
+
+    draw(declared - 2 * L.PAD)
+    with pytest.raises(LayoutOverflowError):
+        draw(declared - 2 * L.PAD - 1)
