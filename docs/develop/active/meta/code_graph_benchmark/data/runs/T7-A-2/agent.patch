+@pytest.mark.parametrize("sense, vec", [("Olfaction", 5), ("Visual", 8), ("Visual", 4)])
+@pytest.mark.parametrize("r", [1, 2, 3])
+def test_a_sense_panel_declares_exactly_the_width_its_painter_needs(sense, vec, r):
+    """The painter draws at the declared width and refuses one pixel less."""
+    matplotlib = pytest.importorskip("matplotlib")
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+
+    from src.environment.dashboard import painters as PN
+    from src.environment.dashboard.labels import channel_labels
+    from src.environment.sensor import get_visual_offsets
+
+    key = "olfactory" if sense == "Olfaction" else "visual"
+    kw = ({"olfactory_range": r, "olfactory_channels": vec} if key == "olfactory"
+          else {"visual_range": r, "visual_vector_size": vec})
+    ctx = LayoutContext(10, 10, 5, {sense: 1}, False, False, **kw)
+    spec = next(s for s in P.PANELS if s.key == key)
+    declared = spec.min_size(ctx)
+    BAND_H = 236  # the band a 10x10 world gets; height is the packer's, not this test's
+    codes = channel_labels(sense, vec)
+    offs = [tuple(o) for o in get_visual_offsets(r)]
+
+    def draw(card_w):
+        fig, ax = plt.subplots()
+        ax._px_w, ax._px_h = card_w, BAND_H
+        try:
+            PN.build_channel_maps(_StubDash(), ax, PN.PAD, card_w - 2 * PN.PAD,
+                                  BAND_H, sense, sense, codes, ("#fff", "#000"),
+                                  offs, r)
+        finally:
+            plt.close(fig)
+
+    draw(declared.w)
+    with pytest.raises(LayoutOverflowError):
+        draw(declared.w - 1)
+
+
+def test_the_map_plan_is_importable_from_both_modules_and_counts_six_vision_maps():
+    from src.environment.dashboard import painters as PN
+    from src.environment.dashboard.labels import visual_labels
+
+    assert PN.map_plan is P.map_plan
+    assert len(P.map_plan("Visual", visual_labels(8))) == 6
+    assert len(P.map_plan("Visual", visual_labels(4))) == 4
+    assert PN.MAP_GAP == P.MAP_GAP_PX
