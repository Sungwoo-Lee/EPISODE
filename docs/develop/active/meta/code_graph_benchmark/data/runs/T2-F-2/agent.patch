diff --git a/tests/models/test_return_mode_mc_fixed.py b/tests/models/test_return_mode_mc_fixed.py
new file mode 100644
index 0000000..4630424
--- /dev/null
+++ b/tests/models/test_return_mode_mc_fixed.py
@@ -0,0 +1,121 @@
+"""Tests for the "MC_FIXED" return mode and `validate_return_mode`.
+
+Plain-language context: recurrent PPO can turn a rollout into learning signals two ways —
+"MC" (Monte-Carlo returns, normalised) or "GAE". "MC_FIXED" uses the SAME Monte-Carlo returns
+as "MC" but the GAE branch's bookkeeping: raw returns are the critic target and advantages are
+normalised with the GAE branch's form (epsilon 1e-8). The trainer internals are exercised here
+with a synthetic rollout, so no environment is needed.
+"""
+from types import SimpleNamespace
+
+import jax
+import jax.numpy as jnp
+import pytest
+
+from src.models import recurrent_ppo_trainer as rt
+from src.models import ppo_trainer as pt
+
+T, B = 6, 3
+GAMMA = 0.9
+
+
+def _synthetic_rollout():
+    k = jax.random.split(jax.random.PRNGKey(0), 4)
+    reward = jax.random.normal(k[0], (T, B))
+    value = jax.random.normal(k[1], (T, B))
+    done = jnp.zeros((T, B), dtype=bool).at[2, 0].set(True).at[T - 1, 1].set(True)
+    term_reason = jnp.zeros((T, B), dtype=jnp.int32).at[2, 0].set(1).at[T - 1, 1].set(2)
+    traj = rt.Transition(
+        obs=jnp.zeros((T, B, 1)), action=jnp.zeros((T, B), dtype=jnp.int32), reward=reward,
+        done=done, log_prob=jnp.zeros((T, B)), value=value, mod_info=None,
+        step_info=SimpleNamespace(termination_reason=term_reason),
+        next_value=jax.random.normal(k[2], (T, B)),
+    )
+    h_states = jnp.zeros((T, B, 2))
+    boot = jax.random.normal(k[3], (B,))
+    return traj, h_states, boot
+
+
+def _run(monkeypatch, mode):
+    traj, h_states, boot = _synthetic_rollout()
+    captured = {}
+    monkeypatch.setattr(
+        rt, "collect_trajectories",
+        lambda *a, **kw: (traj, h_states, "state", "h", "key", boot),
+    )
+
+    def fake_update(model, optimizer, batch, config):
+        captured["batch"] = batch
+        return 0.0, ()
+
+    monkeypatch.setattr(rt, "update_step", fake_update)
+    cfg = SimpleNamespace(rnn_type="LSTM", return_mode=mode, num_steps=T, gamma=GAMMA,
+                          gae_lambda=0.95, num_epochs=1)
+    rt.train_iteration(None, None, None, None, None, None, cfg)
+    return traj, boot, captured["batch"]
+
+
+def _raw_mc(traj, boot):
+    terms = (traj.step_info.termination_reason >= 2).astype(traj.done.dtype)
+    return jax.vmap(rt.compute_mc_returns, in_axes=(1, 1, 1, 0, None), out_axes=1)(
+        traj.reward, traj.done, terms, boot, GAMMA
+    )
+
+
+def test_mc_fixed_uses_raw_targets_and_gae_style_advantages(monkeypatch):
+    traj, boot, batch = _run(monkeypatch, "MC_FIXED")
+    raw = _raw_mc(traj, boot)
+    adv = raw - traj.value
+    expected_adv = (adv - jnp.mean(adv)) / (jnp.std(adv) + 1e-8)
+    assert jnp.array_equal(batch.targets, raw)
+    assert jnp.array_equal(batch.advantages, expected_adv)
+
+
+def test_mc_unchanged(monkeypatch):
+    traj, boot, batch = _run(monkeypatch, "MC")
+    raw = _raw_mc(traj, boot)
+    norm = (raw - jnp.mean(raw)) / (jnp.std(raw) + 1e-7)
+    assert jnp.array_equal(batch.targets, norm)
+    assert jnp.array_equal(batch.advantages, norm - traj.value)
+
+
+def test_gae_unchanged(monkeypatch):
+    traj, _, batch = _run(monkeypatch, "GAE")
+    terms = (traj.step_info.termination_reason >= 2).astype(traj.done.dtype)
+    adv = jax.vmap(rt.compute_gae, in_axes=(1, 1, 1, 1, 1, None, None), out_axes=1)(
+        traj.reward, traj.value, traj.next_value, traj.done, terms, GAMMA, 0.95
+    )
+    assert jnp.array_equal(batch.targets, adv + traj.value)
+    assert jnp.array_equal(batch.advantages, (adv - jnp.mean(adv)) / (jnp.std(adv) + 1e-8))
+
+
+def test_lowercase_mode_is_accepted_by_train_iteration(monkeypatch):
+    traj, boot, batch = _run(monkeypatch, " mc_fixed ")
+    assert jnp.array_equal(batch.targets, _raw_mc(traj, boot))
+
+
+@pytest.mark.parametrize("raw,canonical", [
+    ("MC", "MC"), ("mc", "MC"), ("Mc_Fixed", "MC_FIXED"), ("  gae\n", "GAE"), ("MC_FIXED", "MC_FIXED"),
+])
+def test_validate_accepts_and_canonicalises(raw, canonical):
+    assert rt.validate_return_mode(raw) == canonical
+
+
+@pytest.mark.parametrize("bad", ["", "MCFIXED", "MC-FIXED", "gae2", "TD", None, 3])
+def test_validate_rejects(bad):
+    with pytest.raises(ValueError) as e:
+        rt.validate_return_mode(bad)
+    for name in ("MC", "MC_FIXED", "GAE"):
+        assert name in str(e.value)
+
+
+def test_train_iteration_rejects_invalid_mode():
+    cfg = SimpleNamespace(rnn_type="LSTM", return_mode="bogus", num_steps=T)
+    with pytest.raises(ValueError, match="MC_FIXED"):
+        rt.train_iteration(None, None, None, None, None, None, cfg)
+
+
+def test_plain_ppo_rejects_mc_fixed():
+    cfg = SimpleNamespace(return_mode="MC_FIXED")
+    with pytest.raises(ValueError, match="MC_FIXED"):
+        pt.train_iteration_ppo(None, None, None, None, None, cfg)
