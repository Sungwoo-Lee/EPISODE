@@ -246,6 +246,40 @@ def test_occlusion_defaults_off_and_validates_its_subkeys():
             params(**bad)
 
 
+_BLUR_KNOBS = ('radial_scale', 'anisotropy', 'sigma_floor')
+
+
+def _params_without_blur_knobs(missing=_BLUR_KNOBS, **overrides):
+    c = Config.load_yaml(DEFAULT)
+    for k in missing:
+        del c.to_dict()['sensory'][f'visual_blur_{k}']
+    for k, v in overrides.items():
+        c.set(k, v)
+    return load_env_params(c)
+
+
+def test_blur_knobs_are_not_required_when_blur_is_off():
+    p = _params_without_blur_knobs()
+    assert p.visual_blur_enabled is False
+
+
+@pytest.mark.parametrize('knob', _BLUR_KNOBS)
+def test_blur_knob_is_required_when_blur_is_on(knob):
+    with pytest.raises(ValueError, match=f'visual_blur_{knob}'):
+        _params_without_blur_knobs(missing=(knob,), **{'sensory.visual_blur_enabled': True})
+
+
+@pytest.mark.parametrize('overrides, knob', [
+    ({'sensory.visual_blur_anisotropy': 0.0}, 'anisotropy'),
+    ({'sensory.visual_blur_sigma_floor': 0.0, 'sensory.visual_blur_radial_scale': 0.0},
+     'sigma_floor'),
+    ({'sensory.visual_blur_radial_scale': -0.5}, 'radial_scale'),
+])
+def test_blur_value_checks_fire_when_blur_is_on(overrides, knob):
+    with pytest.raises(ValueError, match=f'visual_blur_{knob}'):
+        params(**{'sensory.visual_blur_enabled': True, **overrides})
+
+
 def test_occlusion_hides_only_what_is_behind_a_blocker():
