diff --git a/tests/env/test_thermal_rate_scales.py b/tests/env/test_thermal_rate_scales.py
new file mode 100644
index 0000000..582f1f6
--- /dev/null
+++ b/tests/env/test_thermal_rate_scales.py
@@ -0,0 +1,148 @@
+"""Asymmetric warming / cooling speed of the body temperature.
+
+In plain terms: the body used to move by `d` each step, where
+`d = k_exchange*(field - T) + k_metabolic - k_loss*(T - setpoint)`. It now moves by
+`s*d`, with `s = thermal.warming_rate_scale` when `d > 0` and
+`thermal.cooling_rate_scale` otherwise. Scaling the WHOLE step keeps every
+settling temperature where it was; only the speed of approach changes.
+"""
+import os
+
+os.environ.setdefault("JAX_PLATFORMS", "cpu")
+
+import copy
+import sys
+
+import numpy as np
+import pytest
+import yaml
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+_ROOT = os.path.abspath(os.path.join(_HERE, "..", ".."))
+sys.path.insert(0, _ROOT)
+
+import jax
+
+from src.utils.config import Config
+from src.environment.config_loader import load_env_params
+from src.environment.core import jax_reset, jax_step
+
+THERMAL_CONFIG = os.path.join(
+    _ROOT, "configs", "environment", "experiment", "archive", "thermal", "campfire_world.yaml")
+REST = 4
+
+
+def _uniform(cell_temp, **thermal):
+    d = copy.deepcopy(yaml.safe_load(open(THERMAL_CONFIG)))
+    d["thermal"].update(use_object_sources=False, use_random_spots=False,
+                        default_temp=[float(cell_temp), float(cell_temp)], **thermal)
+    d["environment"]["entities"] = []
+    d["environment"]["obstacles"] = [
+        o for o in d["environment"]["obstacles"] if o.get("name") == "campfire"]
+    d["environment"]["resources"] = [
+        r for r in d["environment"]["resources"] if r.get("type") == "food"]
+    d["environment"]["max_steps"] = 500
+    d["body"]["metabolic_cost"] = 0.0
+    return d
+
+
+def _traj(d, n):
+    params = load_env_params(Config(d))
+    state = jax_reset(params, jax.random.PRNGKey(0))
+    out = [float(state.body_temp)]
+    for _ in range(n):
+        state, _, done, _ = jax_step(state, REST, params)
+        out.append(float(state.body_temp))
+        if bool(done):
+            break
+    return np.array(out)
+
+
+def test_shipped_configs_are_unscaled():
+    params = load_env_params(Config(_uniform(-10.0)))
+    assert params.thermal_warming_rate_scale == 1.0
+    assert params.thermal_cooling_rate_scale == 1.0
+
+
+def test_thermal_off_params_are_inert():
+    d = _uniform(-10.0, enabled=False)
+    params = load_env_params(Config(d))
+    assert (params.thermal_warming_rate_scale, params.thermal_cooling_rate_scale) == (1.0, 1.0)
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+def test_keys_are_mandatory_when_thermal_enabled(key):
+    d = _uniform(-10.0)
+    del d["thermal"][key]
+    with pytest.raises(ValueError, match=key):
+        load_env_params(Config(d))
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+def test_keys_not_required_when_thermal_disabled(key):
+    d = _uniform(-10.0, enabled=False)
+    del d["thermal"][key]
+    load_env_params(Config(d))
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+@pytest.mark.parametrize("bad", [0.0, -1.0, float("nan")])
+def test_non_positive_or_nan_rejected(key, bad):
+    with pytest.raises(ValueError, match=f"thermal.{key}"):
+        load_env_params(Config(_uniform(-10.0, **{key: bad})))
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+def test_monotone_bound_rejected_and_boundary_accepted(key):
+    # k_exchange + k_loss = 0.05, so the bound is scale <= 20.
+    with pytest.raises(ValueError, match=f"thermal.{key}"):
+        load_env_params(Config(_uniform(-10.0, **{key: 20.5})))
+    params = load_env_params(Config(_uniform(-10.0, **{key: 20.0})))
+    assert getattr(params, "thermal_" + key) == 20.0
+
+
+def test_unscaled_stability_check_kept():
+    with pytest.raises(ValueError, match="k_exchange"):
+        load_env_params(Config(_uniform(-10.0, k_exchange=0.9, k_loss=0.2)))
+
+
+def test_cooling_scale_speeds_cooling_and_keeps_fixed_point():
+    base = _traj(_uniform(-10.0), 400)
+    fast = _traj(_uniform(-10.0, cooling_rate_scale=2.0), 400)
+    # Body starts at the setpoint (0) in a -10 cell: every step is cooling, d < 0.
+    np.testing.assert_allclose(fast[1], 2.0 * base[1], atol=1e-5)
+    assert fast[10] < base[10]
+    assert fast[-1] == pytest.approx(-8.0, abs=1e-3)
+    assert base[-1] == pytest.approx(-8.0, abs=1e-3)
+
+
+def test_warming_scale_does_not_touch_a_purely_cooling_trajectory():
+    base = _traj(_uniform(-10.0), 100)
+    other = _traj(_uniform(-10.0, warming_rate_scale=3.0), 100)
+    np.testing.assert_allclose(other, base, atol=1e-4)  # float32 reassociation
+
+
+def test_whole_step_is_scaled_including_loss_and_metabolic_terms():
+    # Warm cell, non-zero metabolic drift: d = k_ex*(f - T) + k_met - k_loss*(T - set).
+    d = _uniform(10.0, warming_rate_scale=2.0, k_metabolic=0.1)
+    params = load_env_params(Config(d))
+    state = jax_reset(params, jax.random.PRNGKey(0))
+    t0 = float(state.body_temp)
+    delta = 0.04 * (10.0 - t0) + 0.1 - 0.01 * (t0 - 0.0)
+    assert delta > 0
+    state, _, _, _ = jax_step(state, REST, params)
+    assert float(state.body_temp) == pytest.approx(t0 + 2.0 * delta, abs=1e-5)
+
+
+def test_fixed_point_unchanged_under_both_scales():
+    d = _uniform(10.0, warming_rate_scale=3.0, cooling_rate_scale=0.5, k_metabolic=0.1)
+    traj = _traj(d, 500)
+    t_star = (0.04 * 10.0 + 0.01 * 0.0 + 0.1) / 0.05
+    assert traj[-1] == pytest.approx(t_star, abs=1e-3)
+
+
+def test_equal_non_unit_scales_are_a_uniform_speed_change():
+    base = _traj(_uniform(-10.0), 5)
+    both = _traj(_uniform(-10.0, warming_rate_scale=2.0, cooling_rate_scale=2.0), 5)
+    assert both[1] == pytest.approx(2.0 * base[1], abs=1e-5)
+
