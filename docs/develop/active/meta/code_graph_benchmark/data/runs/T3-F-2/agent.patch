+# ------------------------------------------------- blur knob validation ---
+
+_BLUR_KNOBS = ('radial_scale', 'anisotropy', 'sigma_floor')
+
+
+def _default_dict_without_blur_knobs():
+    d = Config.load_yaml(DEFAULT).to_dict()
+    for k in _BLUR_KNOBS:
+        d['sensory'].pop('visual_blur_' + k)
+    return d
+
+
+def test_blur_off_loads_without_the_knobs():
+    d = _default_dict_without_blur_knobs()
+    d['sensory']['visual_blur_enabled'] = False
+    assert load_env_params(Config(d)).visual_blur_enabled is False
+
+
+@pytest.mark.parametrize('knob', _BLUR_KNOBS)
+def test_blur_on_missing_knob_raises(knob):
+    d = _default_dict_without_blur_knobs()
+    d['sensory'].update({'visual_blur_enabled': True, 'visual_blur_radial_scale': 0.5,
+                         'visual_blur_anisotropy': 3.0, 'visual_blur_sigma_floor': 0.5})
+    d['sensory'].pop('visual_blur_' + knob)
+    with pytest.raises(ValueError, match='visual_blur'):
+        load_env_params(Config(d))
+
+
+@pytest.mark.parametrize('overrides,knob', [
+    ({'visual_blur_anisotropy': 0.0}, 'visual_blur_anisotropy'),
+    ({'visual_blur_sigma_floor': 0.0, 'visual_blur_radial_scale': 0.0}, 'visual_blur_sigma_floor'),
+    ({'visual_blur_radial_scale': -0.1}, 'visual_blur_radial_scale'),
+])
+def test_blur_on_value_checks_still_fire(overrides, knob):
+    with pytest.raises(ValueError, match=knob):
+        params(**{'sensory.visual_blur_enabled': True,
+                  **{'sensory.' + k: v for k, v in overrides.items()}})
+
+
+def test_blur_off_skips_value_checks():
+    """Knobs are only read when blur is on, so a bad value is inert when it is off."""
+    assert params(**{'sensory.visual_blur_anisotropy': 0.0}).visual_blur_enabled is False
+
+
