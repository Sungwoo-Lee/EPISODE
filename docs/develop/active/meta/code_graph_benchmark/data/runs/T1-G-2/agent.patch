     with pytest.raises(ValueError, match=r"min_fire_separation is 0 while 2 heat-source slots"):
         _params(d)
+
+
+# ── 5. asymmetric warming / cooling speed ─────────────────────────────────────
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+@pytest.mark.parametrize("bad", [0.0, -0.5, float("nan")])
+def test_rate_scale_must_be_positive_and_nan_is_rejected(key, bad):
+    with pytest.raises(ValueError, match=rf"thermal\.{key} must be > 0"):
+        _params(_with_thermal(**{key: bad}))
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+def test_rate_scale_must_keep_the_approach_monotone(key):
+    d = _campfire_dict()
+    k_sum = d["thermal"]["k_exchange"] + d["thermal"]["k_loss"]
+    d["thermal"][key] = 1.0 / k_sum + 0.5
+    with pytest.raises(ValueError, match=rf"thermal\.{key} \* \(thermal\.k_exchange"):
+        _params(d)
+    d["thermal"][key] = 1.0 / k_sum            # the boundary is allowed
+    assert float(getattr(_params(d), "thermal_" + key)) == pytest.approx(1.0 / k_sum)
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+def test_rate_scale_is_mandatory_when_thermal_is_on(key):
+    d = _campfire_dict()
+    del d["thermal"][key]
+    with pytest.raises(ValueError, match=key):
+        _params(d)
+
+
+def test_rate_scales_are_not_read_when_thermal_is_off():
+    d = _campfire_dict()
+    d["thermal"]["enabled"] = False
+    del d["thermal"]["warming_rate_scale"]
+    del d["thermal"]["cooling_rate_scale"]
+    params = _params(d)
+    assert params.thermal_warming_rate_scale == 1.0
+    assert params.thermal_cooling_rate_scale == 1.0
