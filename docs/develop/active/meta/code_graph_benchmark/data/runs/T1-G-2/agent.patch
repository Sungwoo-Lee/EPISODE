diff --git a/tests/env/test_thermal_body.py b/tests/env/test_thermal_body.py
index 2b13506..700602d 100644
--- a/tests/env/test_thermal_body.py
+++ b/tests/env/test_thermal_body.py
@@ -341,3 +341,52 @@ def test_body_temp_is_inert_when_thermal_is_off():
         assert int(info["termination_reason"]) != 5, "reason 5 on a thermal-off config"
         if bool(done):
             break
+
+
+# ── asymmetric warming / cooling speed ───────────────────────────────────────
+
+def _scaled_params(cell_temp, warming, cooling):
+    d = _uniform_field_config(cell_temp)
+    d["thermal"]["warming_rate_scale"] = warming
+    d["thermal"]["cooling_rate_scale"] = cooling
+    return load_env_params(Config(d))
+
+
+def _body_temp_after_one_step(params, start):
+    state = jax_reset(params, jax.random.PRNGKey(0))
+    state = state._replace(body_temp=jnp.asarray(start, dtype=jnp.float32))
+    state, _, _, _ = jax_step(state, REST, params)
+    return float(state.body_temp)
+
+
+def test_rate_scales_multiply_the_whole_step_by_direction():
+    """d > 0 is scaled by warming_rate_scale, d <= 0 by cooling_rate_scale."""
+    params = _scaled_params(-10.0, warming=2.0, cooling=0.5)
+    assert params.thermal_warming_rate_scale == 2.0
+    k_ex = float(params.thermal_k_exchange)
+    k_loss = float(params.thermal_k_loss)
+    k_met = float(params.thermal_k_metabolic)
+    t_set = float(params.temperature_setpoint)
+    for start in (-14.0, 5.0):      # below the field -> warms; above -> cools
+        d = k_ex * (-10.0 - start) + k_met - k_loss * (start - t_set)
+        scale = 2.0 if d > 0 else 0.5
+        assert _body_temp_after_one_step(params, start) == pytest.approx(
+            start + scale * d, abs=1e-4)
+
+
+def test_rate_scales_leave_the_fixed_point_unchanged():
+    ref = _scaled_params(-25.0, warming=1.0, cooling=1.0)
+    fast = _scaled_params(-25.0, warming=3.0, cooling=0.5)
+    k_ex, k_loss = float(ref.thermal_k_exchange), float(ref.thermal_k_loss)
+    t_star = k_ex * -25.0 / (k_ex + k_loss)
+    for params in (ref, fast):
+        assert _body_temp_after_one_step(params, t_star) == pytest.approx(t_star, abs=1e-4)
+
+
+def test_scales_of_exactly_one_keep_the_original_expression():
+    """Equal scales other than 1.0 are a uniform speed change, not today's step."""
+    one = _scaled_params(-10.0, 1.0, 1.0)
+    uniform = _scaled_params(-10.0, 0.5, 0.5)
+    step_one = _body_temp_after_one_step(one, 0.0) - 0.0
+    step_half = _body_temp_after_one_step(uniform, 0.0) - 0.0
+    assert step_half == pytest.approx(0.5 * step_one, abs=1e-5)
