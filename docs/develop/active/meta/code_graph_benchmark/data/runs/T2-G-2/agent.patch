diff --git a/tests/models/test_mc_fixed_return_mode.py b/tests/models/test_mc_fixed_return_mode.py
new file mode 100644
index 0000000..80d6c99
--- /dev/null
+++ b/tests/models/test_mc_fixed_return_mode.py
@@ -0,0 +1,50 @@
+"""Tests for the MC_FIXED return mode and `validate_return_mode`.
+
+Plain-language context: recurrent PPO computes its learning signal in one of two ways,
+"MC" (Monte-Carlo returns, normalised) or "GAE". MC_FIXED is a third mode for a comparison
+experiment: the same MC returns as MC, but with GAE's bookkeeping (raw returns are the
+critic target; advantages normalised the way the GAE branch does). These tests cover the
+mode-name validator and the plain-PPO rejection of the recurrent-only mode.
+"""
+from types import SimpleNamespace
+
+import pytest
+
+from src.models import ppo_trainer
+from src.models import recurrent_ppo_trainer as rt
+from src.models.recurrent_ppo_trainer import validate_return_mode
+
+
+@pytest.mark.parametrize("raw,expected", [
+    ("MC", "MC"), ("mc", "MC"), ("Mc", "MC"),
+    ("MC_FIXED", "MC_FIXED"), ("mc_fixed", "MC_FIXED"), ("  Mc_Fixed\n", "MC_FIXED"),
+    ("GAE", "GAE"), ("gae", "GAE"), (" gae ", "GAE"),
+])
+def test_validate_return_mode_canonicalises(raw, expected):
+    assert validate_return_mode(raw) == expected
+
+
+@pytest.mark.parametrize("bad", ["", "MC-FIXED", "MCFIXED", "TD", "GAE2", None, 3])
+def test_validate_return_mode_rejects_invalid(bad):
+    with pytest.raises(ValueError) as exc:
+        validate_return_mode(bad)
+    msg = str(exc.value)
+    assert "MC" in msg and "MC_FIXED" in msg and "GAE" in msg
+
+
+def test_recurrent_train_iteration_rejects_invalid_mode():
+    cfg = SimpleNamespace(rnn_type="GRU", return_mode="MC_FIXD")
+    with pytest.raises(ValueError, match="MC_FIXED"):
+        rt.train_iteration(None, None, None, None, None, None, cfg)
+
+
+def test_recurrent_collect_rejects_invalid_mode():
+    with pytest.raises(ValueError, match="GAE"):
+        rt.collect_trajectories(None, None, None, None, None, 1, return_mode="bogus")
+
+
+@pytest.mark.parametrize("mode", ["MC_FIXED", "mc_fixed", " Mc_Fixed "])
+def test_plain_ppo_rejects_mc_fixed(mode):
+    cfg = SimpleNamespace(return_mode=mode)
+    with pytest.raises(ValueError, match="MC_FIXED"):
+        ppo_trainer.train_iteration_ppo(None, None, None, None, None, cfg)
