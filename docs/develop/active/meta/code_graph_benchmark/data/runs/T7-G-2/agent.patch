+@pytest.mark.parametrize("key,sense,title", [("olfactory", "Olfaction", "Olfaction"),
+                                              ("visual", "Visual", "Vision")])
+@pytest.mark.parametrize("rng", [1, 2, 3])
+def test_a_map_panel_declares_exactly_the_width_the_painter_needs(key, sense, title, rng):
+    """The declared minimum is the painter's real requirement: it draws at
+    exactly that width and refuses one pixel less (the painter is handed the
+    card width minus 2 * PAD)."""
+    import matplotlib
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+
+    from src.environment.dashboard import painters as PN
+    from src.environment.dashboard.layout import LayoutOverflowError
+    from src.environment.sensor import get_visual_offsets
+
+    assert PN.MAP_GAP is P.MAP_GAP_PX
+    ctx = _synthetic(10, thermal=False, olf_range=rng if key == "olfactory" else 1,
+                     vis_range=rng if key == "visual" else 0,
+                     visual_present=True)
+    spec = {s.key: s for s in P.PANELS}[key]
+    declared = spec.min_size(ctx).w
+    codes = (olfactory_labels(ctx.olfactory_channels) if key == "olfactory"
+             else visual_labels(ctx.visual_vector_size))
+    offs = [tuple(o) for o in get_visual_offsets(rng)]
+
+    class _Text:
+        def set(self, s):
+            return 10.0
+
+    class _Dash:
+        sense_max: dict = {}
+        updates: list = []
+
+        def viz_name(self, s):
+            return s
+
+        def fit(self, *a, **k):
+            return _Text()
+
+        def width(self, *a, **k):
+            return 10.0
+
+    def draw(card_w):
+        fig, ax = plt.subplots()
+        ax._px_w, ax._px_h = card_w, 236
+        try:
+            PN.build_channel_maps(_Dash(), ax, 0, card_w - 2 * PN.PAD, 236, sense,
+                                  title, codes, ["#000", "#fff"], offs, rng)
+        finally:
+            plt.close(fig)
+
+    draw(declared)
+    with pytest.raises(LayoutOverflowError):
+        draw(declared - 1)
+
+
+def test_the_map_count_comes_from_map_plan_and_off_standard_widths_get_one_map_each():
+    from src.environment.dashboard.labels import map_plan
+    from src.environment.dashboard import painters as PN
+
+    assert PN._map_plan is map_plan
+    std = _synthetic(10, thermal=False, olf_range=1, vis_range=2, visual_present=True)
+    assert len(map_plan("Visual", visual_labels(8))) == 6
+    odd = LayoutContext(**{**std.__dict__, "visual_vector_size": 5})
+    vis = {s.key: s for s in P.PANELS}["visual"]
+    assert vis.min_size(odd).w == 5 * 5 * 10 + P.MAP_GAP_PX * 4 + 2 * P.PAD
+    assert vis.min_size(std).w == 6 * 5 * 10 + P.MAP_GAP_PX * 5 + 2 * P.PAD
