diff --git a/tests/env/test_dashboard_layout.py b/tests/env/test_dashboard_layout.py
index 7fa4b8f..156faab 100644
--- a/tests/env/test_dashboard_layout.py
+++ b/tests/env/test_dashboard_layout.py
@@ -748,3 +748,40 @@ def test_the_channel_row_heights_agree_with_the_painter_that_draws_them():
         assert 64 + per_col * PN.CHANNEL_ROW_PITCH[sense] + 16 == pinned, (
             f"{key}: {per_col} rows at {PN.CHANNEL_ROW_PITCH[sense]}px no longer "
             f"makes the pinned {pinned}px")
+
+
+# --------------------------------------------------------------------------
+# A diamond-map sense's declared width is EXACTLY what the painter needs.
+# --------------------------------------------------------------------------
+def _maps_width(sense, n_channels, r):
+    """The painter's real requirement, worked from first principles."""
+    from src.environment.dashboard.labels import channel_labels, map_plan
+
+    n_maps = len(map_plan(sense, channel_labels(sense, n_channels)))
+    return n_maps * (2 * r + 1) * P.MAP_CELL_MIN_PX + P.MAP_GAP_PX * (n_maps - 1) + 2 * L.PAD
+
+
+@pytest.mark.parametrize("r", [1, 2, 3])
+def test_declared_sense_width_is_the_painters_requirement(r):
+    ctx = _synthetic(olf_range=r, vis_range=r, visual_present=True)
+    assert P._olf_min_size(ctx).w == _maps_width("Olfaction", 5, r)
+    assert P._visual_min_size(ctx).w == _maps_width("Visual", 8, r)
+
+
+def test_worked_widths_and_shared_gap():
+    ctx = _synthetic(olf_range=1, vis_range=3, visual_present=True)
+    assert P._olf_min_size(ctx).w == 206   # 5 maps: 150 + 4*6 + 32
+    assert P._visual_min_size(ctx).w == 482  # 6 maps (terrain is one): 420 + 5*6 + 32
+    from src.environment.dashboard import painters
+
+    pytest.importorskip("matplotlib")
+    assert painters.MAP_GAP == P.MAP_GAP_PX
+    assert painters.map_plan is not None
+
+
+def test_off_standard_vector_counts_one_map_per_channel():
+    ctx = LayoutContext(
+        world_w=10, world_h=10, local_view_size=5, breakdown={"Visual": 4 * 13},
+        thermal=False, intero_noc_enabled=False, visual_range=2, visual_vector_size=4,
+    )
+    assert P._visual_min_size(ctx).w == 4 * 5 * P.MAP_CELL_MIN_PX + 3 * P.MAP_GAP_PX + 2 * L.PAD
