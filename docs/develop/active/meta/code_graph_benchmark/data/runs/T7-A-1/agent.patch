+def _sense_min_size(ctx: LayoutContext, sense: str, n_channels: int, r: int) -> Size:
+    """A diamond-map panel's declared minimum, equal to what the painter needs.
+
+    The painter draws one map per entry of ``map_plan`` (vision's grass / sand /
+    plain are ONE map), each ``2r+1`` cells of at least ``MAP_CELL_MIN_PX``, with
+    ``MAP_GAP_PX`` between maps -- and it is handed the panel width minus
+    ``2 * PAD``, so that padding is added back here.
+    """
+    n_maps = len(map_plan(sense, channel_labels(sense, n_channels)))
+    return Size(
+        _span(n_maps, r) + 2 * PAD,
+        CARD_TITLE_H + _map_h(r) + PAD,
+    )
+
