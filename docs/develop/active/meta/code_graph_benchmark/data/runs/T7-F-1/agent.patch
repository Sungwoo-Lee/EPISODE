diff --git a/tests/env/test_dashboard_layout.py b/tests/env/test_dashboard_layout.py
index 7fa4b8f..6c6dc4f 100644
--- a/tests/env/test_dashboard_layout.py
+++ b/tests/env/test_dashboard_layout.py
@@ -748,3 +748,61 @@ def test_the_channel_row_heights_agree_with_the_painter_that_draws_them():
         assert 64 + per_col * PN.CHANNEL_ROW_PITCH[sense] + 16 == pinned, (
             f"{key}: {per_col} rows at {PN.CHANNEL_ROW_PITCH[sense]}px no longer "
             f"makes the pinned {pinned}px")
+
+
+@pytest.mark.parametrize("sense,key,vector_field", (
+    ("Olfaction", "olfactory", "olfactory_channels"),
+    ("Visual", "visual", "visual_vector_size"),
+))
+@pytest.mark.parametrize("rng", (1, 2, 3))
+@pytest.mark.parametrize("vector", (None, 6))
+def test_a_sense_panels_declared_width_is_exactly_what_the_painter_needs(
+        sense, key, vector_field, rng, vector):
+    """The painter draws at the declared width and refuses one pixel less.
+
+    The painter is handed the card's width minus ``2 * PAD`` and needs a 10 px
+    cell in every map, so the declared minimum must be exactly that arithmetic on
+    the maps `map_plan` says it draws -- vision's eight channels are SIX maps, and
+    an off-standard vector width is one map per channel. Driven through the real
+    painter rather than a restatement of its formula.
+    """
+    from unittest import mock
+
+    import matplotlib
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+
+    from src.environment.dashboard import painters as PN
+    from src.environment.dashboard.labels import channel_labels, map_plan
+
+    fields = {"olfactory_range": rng, "visual_range": rng}
+    if vector is not None:
+        fields[vector_field] = vector
+    ctx = P.LayoutContext(10, 10, 5, {}, False, False, **fields)
+    declared = P._BY_KEY[key].min_size(ctx)
+    codes = channel_labels(sense, getattr(ctx, vector_field))
+    n_maps = len(map_plan(sense, codes))
+    assert n_maps == (6 if sense == "Visual" and vector is None else len(codes))
+    assert declared.w == (n_maps * (2 * rng + 1) * P.MAP_CELL_MIN_PX
+                          + P.MAP_GAP_PX * (n_maps - 1) + 2 * P.PAD)
+    assert PN.MAP_GAP == P.MAP_GAP_PX
+
+    dash = mock.MagicMock()
+    dash.fit.return_value.set.return_value = 20.0
+    dash.width.return_value = 20.0
+    dash.sense_max = {}
+    offs = [(dr, dc) for dr in range(-rng, rng + 1) for dc in range(-rng, rng + 1)
+            if abs(dr) + abs(dc) <= rng]
+
+    def draw(card_w):
+        fig, ax = plt.subplots()
+        ax._px_w, ax._px_h = card_w, 236   # what the painter's gradient reads
+        try:
+            PN.build_channel_maps(dash, ax, 0, card_w - 2 * PN.PAD, 236, sense, "T",
+                                  codes, ("#fff", "#000"), offs, rng)
+        finally:
+            plt.close(fig)
+
+    draw(declared.w)
+    with pytest.raises(LayoutOverflowError):
+        draw(declared.w - 1)
