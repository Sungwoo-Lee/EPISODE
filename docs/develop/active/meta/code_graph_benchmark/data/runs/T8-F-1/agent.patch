+# ---------------------------------------------------------------------------
+# GAE_NORM / MC_RAW: the remaining two cells of the estimator x scaling cross
+# ---------------------------------------------------------------------------
+
+def test_legal_return_modes_order():
+    assert rpt.LEGAL_RETURN_MODES == ("MC", "MC_FIXED", "GAE", "GAE_NORM", "MC_RAW")
+
+
+def test_mc_raw_is_mc_fixed_without_advantage_normalisation(monkeypatch):
+    raw, _, traj, boot = _capture_batch("MC_RAW", monkeypatch)
+    fixed, _, _, _ = _capture_batch("MC_FIXED", monkeypatch)
+    expected = _expected_returns(traj, boot)
+    assert jnp.allclose(raw.targets, expected, atol=1e-6)
+    assert jnp.allclose(raw.targets, fixed.targets)
+    assert jnp.allclose(raw.advantages, expected - traj.value, atol=1e-6)
+    assert abs(float(jnp.std(raw.advantages)) - 1.0) > 1e-3
+
+
+def _gae_advantages(traj):
+    terminateds = (traj.step_info.termination_reason >= 2).astype(traj.done.dtype)
+    return jax.vmap(rpt.compute_gae, in_axes=(1, 1, 1, 1, 1, None, None), out_axes=1)(
+        traj.reward, traj.value, traj.next_value, traj.done, terminateds,
+        GAMMA, _Cfg.gae_lambda)
+
+
+def test_gae_norm_zscores_gae_target_and_leaves_advantage_as_residual(monkeypatch):
+    batch, _, traj, _ = _capture_batch("GAE_NORM", monkeypatch)
+    raw_target = _gae_advantages(traj) + traj.value
+    expected = (raw_target - jnp.mean(raw_target)) / (jnp.std(raw_target) + 1e-7)
+    assert jnp.allclose(batch.targets, expected, atol=1e-5)
+    assert jnp.allclose(batch.advantages, batch.targets - traj.value, atol=1e-6)
+    assert abs(float(jnp.std(batch.advantages)) - 1.0) > 1e-3
+
+
+def test_gae_norm_targets_are_zscored_and_gae_is_unchanged(monkeypatch):
+    norm, _, _, _ = _capture_batch("GAE_NORM", monkeypatch)
+    assert float(jnp.mean(norm.targets)) == pytest.approx(0.0, abs=1e-5)
+    assert float(jnp.std(norm.targets)) == pytest.approx(1.0, abs=1e-4)
+    gae, _, traj, _ = _capture_batch("GAE", monkeypatch)
+    raw = _gae_advantages(traj)
+    assert jnp.allclose(gae.targets, raw + traj.value, atol=1e-6)
+    assert jnp.allclose(gae.advantages, (raw - jnp.mean(raw)) / (jnp.std(raw) + 1e-8), atol=1e-6)
+
+
+@pytest.mark.parametrize("mode", ["GAE_NORM", "MC_RAW", "gae_norm", "mc_raw", "MC_FIXED"])
+def test_plain_ppo_rejects_recurrent_only_modes(mode):
+    from src.models.ppo_trainer import train_iteration_ppo
+
+    class _PpoCfg:
+        return_mode = mode
