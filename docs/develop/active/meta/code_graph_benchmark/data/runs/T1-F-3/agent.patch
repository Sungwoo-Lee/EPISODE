diff --git a/tests/env/test_thermal_rate_scale.py b/tests/env/test_thermal_rate_scale.py
new file mode 100644
index 0000000..471f0f4
--- /dev/null
+++ b/tests/env/test_thermal_rate_scale.py
@@ -0,0 +1,188 @@
+"""Asymmetric body-temperature speed: `thermal.warming_rate_scale` / `cooling_rate_scale`.
+
+Plain terms: the body used to close a fixed fraction of the gap each step whether it
+was warming or cooling. These two keys let it warm and cool at different speeds by
+scaling the WHOLE per-step change d (s = warming scale when d > 0, else cooling
+scale). Because the whole step is scaled, every settling temperature is unchanged.
+
+Checked here, independently of `core.py`: the closed-form trajectory and fixed point,
+that both-1.0 is exactly today's trajectory, that the metabolic-coupling drain is not
+scaled, and that the loader refuses bad values by naming the key.
+"""
+import os
+
+os.environ.setdefault("JAX_PLATFORMS", "cpu")
+
+import copy
+import sys
+
+import numpy as np
+import pytest
+import yaml
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+_ROOT = os.path.abspath(os.path.join(_HERE, "..", ".."))
+sys.path.insert(0, _ROOT)
+sys.path.insert(0, _HERE)
+
+import jax
+
+from src.utils.config import Config
+from src.environment.config_loader import load_env_params, load_env_config
+from src.environment.core import jax_reset, jax_step
+from test_thermal_body import _uniform_field_config, _params, _rollout, REST
+
+_CONFIGS = os.path.join(_ROOT, "configs", "environment")
+SHIPPED_THERMAL_CONFIGS = [
+    os.path.join(_CONFIGS, "default.yaml"),
+    os.path.join(_CONFIGS, "experiment", "archive", "thermal", "campfire_world.yaml"),
+    os.path.join(_CONFIGS, "experiment", "archive", "thermal", "campfire_world_body_temp_hidden.yaml"),
+]
+
+K_EX, K_LOSS, SETPOINT = 0.04, 0.01, 0.0
+
+
+def _scaled(cell_temp, warming, cooling, **thermal):
+    d = _uniform_field_config(cell_temp)
+    d["thermal"]["warming_rate_scale"] = warming
+    d["thermal"]["cooling_rate_scale"] = cooling
+    d["thermal"].update(thermal)
+    return d
+
+
+def _oracle(cell_temp, warming, cooling, n):
+    t, out = 0.0, [0.0]
+    for _ in range(n):
+        d = K_EX * (cell_temp - t) - K_LOSS * (t - SETPOINT)
+        t = t + (warming if d > 0 else cooling) * d
+        out.append(t)
+    return np.array(out)
+
+
+# ── shipped configs ───────────────────────────────────────────────────────────
+
+@pytest.mark.parametrize("path", SHIPPED_THERMAL_CONFIGS, ids=os.path.basename)
+def test_shipped_configs_carry_unit_scales(path):
+    d = yaml.safe_load(open(path))
+    assert d["thermal"]["warming_rate_scale"] == 1.0
+    assert d["thermal"]["cooling_rate_scale"] == 1.0
+
+
+@pytest.mark.parametrize("path", SHIPPED_THERMAL_CONFIGS[1:], ids=os.path.basename)
+def test_shipped_thermal_worlds_load_with_unit_scales(path):
+    p = load_env_params(Config(yaml.safe_load(open(path))))
+    assert p.thermal_enabled
+    assert (p.thermal_warming_rate_scale, p.thermal_cooling_rate_scale) == (1.0, 1.0)
+
+
+@pytest.mark.parametrize("name", ["05-campfire_thermal_10x10.yaml", "06-sensory_noise_10x10.yaml"])
+def test_basic_thermal_worlds_inherit_unit_scales(name):
+    path = os.path.join(_CONFIGS, "experiment", "basic", name)
+    p = load_env_params(load_env_config(path))
+    assert p.thermal_enabled
+    assert (p.thermal_warming_rate_scale, p.thermal_cooling_rate_scale) == (1.0, 1.0)
+
+
+# ── loading ───────────────────────────────────────────────────────────────────
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+def test_missing_key_raises_naming_it_when_thermal_on(key):
+    d = _scaled(-10.0, 1.0, 1.0)
+    del d["thermal"][key]
+    with pytest.raises(ValueError, match=key):
+        _params(d)
+
+
+def test_keys_not_required_when_thermal_off():
+    d = _scaled(-10.0, 1.0, 1.0, enabled=False)
+    del d["thermal"]["warming_rate_scale"], d["thermal"]["cooling_rate_scale"]
+    p = _params(d)
+    assert (p.thermal_warming_rate_scale, p.thermal_cooling_rate_scale) == (1.0, 1.0)
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+@pytest.mark.parametrize("bad", [0.0, -0.5, float("nan")])
+def test_non_positive_or_nan_rejected(key, bad):
+    d = _scaled(-10.0, 1.0, 1.0)
+    d["thermal"][key] = bad
+    with pytest.raises(ValueError, match=f"thermal.{key} must be > 0"):
+        _params(d)
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+def test_monotone_bound_enforced_and_boundary_accepted(key):
+    d = _scaled(-10.0, 1.0, 1.0)
+    d["thermal"][key] = 21.0          # 21 * 0.05 = 1.05 > 1
+    with pytest.raises(ValueError, match=f"thermal.{key} \\* "):
+        _params(d)
+    d["thermal"][key] = 20.0          # 20 * 0.05 == 1 : allowed
+    assert _params(d) is not None
+
+
+def test_unscaled_stability_check_still_present():
+    d = _scaled(-10.0, 0.5, 0.5, k_exchange=0.9, k_loss=0.2)
+    with pytest.raises(ValueError, match=r"thermal\.k_exchange \+ thermal\.k_loss must be <= 1"):
+        _params(d)
+
+
+# ── dynamics ──────────────────────────────────────────────────────────────────
+
+@pytest.mark.parametrize("cell,warming,cooling", [
+    (-10.0, 3.0, 0.5),      # cooling: only the cooling scale matters
+    (-10.0, 0.5, 3.0),
+    (10.0, 3.0, 0.5),       # warming: only the warming scale matters
+    (10.0, 0.5, 3.0),
+])
+def test_trajectory_matches_closed_form(cell, warming, cooling):
+    n = 60
+    traj, *_ = _rollout(_params(_scaled(cell, warming, cooling)), n)
+    # Stay inside the survivable interval so the rollout runs the full n steps.
+    assert len(traj) == n + 1
+    np.testing.assert_allclose(traj, _oracle(cell, warming, cooling, n), rtol=1e-4, atol=1e-4)
+
+
+def test_fixed_point_is_unchanged_by_the_scales():
+    cell = -10.0
+    t_star = K_EX * cell / (K_EX + K_LOSS)
+    for w, c in [(1.0, 1.0), (4.0, 0.5), (0.5, 4.0)]:
+        traj, *_ = _rollout(_params(_scaled(cell, w, c)), 500)
+        np.testing.assert_allclose(traj[-1], t_star, atol=1e-3)
+
+
+def test_unit_scales_reproduce_todays_trajectory_exactly():
+    base = _uniform_field_config(-10.0)
+    base["thermal"]["warming_rate_scale"] = 1.0
+    base["thermal"]["cooling_rate_scale"] = 1.0
+    traj, *_ = _rollout(_params(base), 80)
+    np.testing.assert_allclose(traj, _oracle(-10.0, 1.0, 1.0, 80), rtol=1e-5, atol=1e-5)
+
+
+def test_equal_non_unit_scales_are_a_uniform_speed_change():
+    n = 30
+    slow, *_ = _rollout(_params(_scaled(-10.0, 0.5, 0.5)), n)
+    base, *_ = _rollout(_params(_scaled(-10.0, 1.0, 1.0)), n)
+    assert abs(slow[10]) < abs(base[10]), "0.5/0.5 must be slower than today, not identical"
+
+
+def test_static_branch_changes_the_traced_step_only_off_unit():
+    def eqns(w, c):  # the traced program, as text
+        p = _params(_scaled(-10.0, w, c))
+        s = jax_reset(p, jax.random.PRNGKey(0))
+        return str(jax.make_jaxpr(lambda st: jax_step(st, REST, p))(s))
+    assert eqns(1.0, 1.0) == eqns(1.0, 1.0)
+    assert eqns(1.0, 1.0) != eqns(0.5, 0.5)
+
+
+def test_metabolic_coupling_drain_is_not_scaled():
+    """Same pre-step state, different scales: nutrition after the step is identical."""
+    outs = []
+    for w, c in [(1.0, 1.0), (0.3, 0.3), (4.0, 0.2)]:
+        d = _scaled(-10.0, w, c, metabolic_coupling=True, metabolic_coupling_rate=2.0)
+        d["body"]["metabolic_cost"] = 0.0
+        p = _params(d)
+        s = jax_reset(p, jax.random.PRNGKey(0))
+        s = s.replace(body_temp=np.float32(-8.0))
+        s2, *_ = jax_step(s, REST, p)
+        outs.append(float(s2.nutrition))
+    assert outs[0] == outs[1] == outs[2]
+    assert outs[0] < float(jax_reset(p, jax.random.PRNGKey(0)).nutrition), "drain did not fire"
