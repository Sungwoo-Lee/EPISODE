diff --git a/tests/env/test_thermal_rate_scales.py b/tests/env/test_thermal_rate_scales.py
new file mode 100644
index 0000000..65b86b1
--- /dev/null
+++ b/tests/env/test_thermal_rate_scales.py
@@ -0,0 +1,191 @@
+"""Asymmetric warming / cooling speed of the body temperature.
+
+Plain terms: the body used to move by `d` each step, where `d` is the exchange
+with the cell, plus the metabolic term, minus the physiological pull-back. Two
+config keys now let it move by `s * d`, with `s = thermal.warming_rate_scale`
+when `d > 0` and `thermal.cooling_rate_scale` otherwise. The whole step is
+scaled, so every settling temperature stays where it was; only the speed of
+approach changes. The metabolic-coupling nutrition drain is not scaled.
+
+Expected values are the hand-computed recurrence, not a call back into core.py.
+"""
+import os
+
+os.environ.setdefault("JAX_PLATFORMS", "cpu")
+
+import copy
+import glob
+import sys
+
+import pytest
+import yaml
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+_ROOT = os.path.abspath(os.path.join(_HERE, "..", ".."))
+sys.path.insert(0, _ROOT)
+
+import jax
+
+from src.utils.config import Config
+from src.environment.config_loader import load_env_params, load_env_config
+from src.environment.core import jax_reset, jax_step
+
+THERMAL_CONFIG = os.path.join(
+    _ROOT, "configs", "environment", "experiment", "archive", "thermal", "campfire_world.yaml")
+REST = 4
+K_EX, K_LOSS = 0.04, 0.01     # campfire_world.yaml; setpoint 0.0
+
+
+def _uniform(cell_temp, **thermal):
+    """Thermal world whose field is the constant `cell_temp` everywhere."""
+    d = copy.deepcopy(yaml.safe_load(open(THERMAL_CONFIG)))
+    d["thermal"].update(use_object_sources=False, use_random_spots=False,
+                        default_temp=[float(cell_temp), float(cell_temp)], **thermal)
+    d["environment"]["entities"] = []
+    d["environment"]["obstacles"] = [
+        o for o in d["environment"]["obstacles"] if o.get("name") == "campfire"]
+    d["environment"]["resources"] = [
+        r for r in d["environment"]["resources"] if r.get("type") == "food"]
+    d["environment"]["max_steps"] = 2000
+    d["body"]["metabolic_cost"] = 0.0
+    return d
+
+
+def _params(d):
+    return load_env_params(Config(d))
+
+
+def _traj(params, n, body_temp=None):
+    state = jax_reset(params, jax.random.PRNGKey(0))
+    if body_temp is not None:
+        state = state.replace(body_temp=jax.numpy.float32(body_temp))
+    out = [float(state.body_temp)]
+    for _ in range(n):
+        state, _, done, _ = jax_step(state, REST, params)
+        out.append(float(state.body_temp))
+        assert not bool(done)
+    return out
+
+
+def _expected(t0, cell, n, warm, cool):
+    t, out = t0, [t0]
+    for _ in range(n):
+        d = K_EX * (cell - t) - K_LOSS * t
+        t = t + (warm if d > 0 else cool) * d
+        out.append(t)
+    return out
+
+
+# ── behaviour ─────────────────────────────────────────────────────────────────
+
+def test_cooling_uses_cooling_scale_and_ignores_warming_scale():
+    p = _params(_uniform(-10.0, warming_rate_scale=2.0, cooling_rate_scale=0.5))
+    got = _traj(p, 5)
+    assert got == pytest.approx(_expected(got[0], -10.0, 5, 2.0, 0.5), rel=1e-5, abs=1e-6)
+    assert got[1] - got[0] == pytest.approx(0.5 * (K_EX * (-10.0 - got[0]) - K_LOSS * got[0]),
+                                            rel=1e-5, abs=1e-6)
+
+
+def test_warming_uses_warming_scale_and_ignores_cooling_scale():
+    p = _params(_uniform(10.0, warming_rate_scale=0.5, cooling_rate_scale=2.0))
+    got = _traj(p, 5)
+    assert got == pytest.approx(_expected(got[0], 10.0, 5, 0.5, 2.0), rel=1e-5, abs=1e-6)
+
+
+@pytest.mark.parametrize("cell", [-10.0, 10.0])
+def test_settling_temperature_is_unchanged(cell):
+    fixed_point = K_EX * cell / (K_EX + K_LOSS)
+    p = _params(_uniform(cell, warming_rate_scale=0.4, cooling_rate_scale=1.5))
+    assert _traj(p, 600)[-1] == pytest.approx(fixed_point, abs=1e-3)
+
+
+def test_equal_scales_other_than_one_are_a_uniform_speed_change():
+    slow = _traj(_params(_uniform(-10.0, warming_rate_scale=0.5, cooling_rate_scale=0.5)), 3)
+    base = _traj(_params(_uniform(-10.0, warming_rate_scale=1.0, cooling_rate_scale=1.0)), 3)
+    assert slow[1] - slow[0] == pytest.approx(0.5 * (base[1] - base[0]), rel=1e-5)
+
+
+def test_unit_scales_match_the_unscaled_recurrence_exactly():
+    got = _traj(_params(_uniform(-10.0, warming_rate_scale=1.0, cooling_rate_scale=1.0)), 20)
+    assert got == pytest.approx(_expected(got[0], -10.0, 20, 1.0, 1.0), rel=1e-6, abs=1e-6)
+
+
+def test_metabolic_coupling_drain_is_not_scaled():
+    kw = dict(metabolic_coupling=True, metabolic_coupling_rate=1.0)
+    d1 = _uniform(-10.0, warming_rate_scale=1.0, cooling_rate_scale=1.0, **kw)
+    d2 = _uniform(-10.0, warming_rate_scale=0.3, cooling_rate_scale=0.3, **kw)
+    for d in (d1, d2):
+        d["body"]["metabolic_cost"] = 0.01      # opens the nutrition block
+    nutr = []
+    for d in (d1, d2):
+        p = _params(d)
+        s = jax_reset(p, jax.random.PRNGKey(0)).replace(body_temp=jax.numpy.float32(-5.0))
+        s2, *_ = jax_step(s, REST, p)
+        nutr.append(float(s2.nutrition))
+    assert nutr[0] == pytest.approx(nutr[1], rel=1e-6)
+
+
+def test_scales_are_static_params_fields():
+    p = _params(_uniform(-10.0, warming_rate_scale=0.5, cooling_rate_scale=0.25))
+    assert p.thermal_warming_rate_scale == 0.5 and p.thermal_cooling_rate_scale == 0.25
+    fields = type(p).__dataclass_fields__
+    for name in ("thermal_warming_rate_scale", "thermal_cooling_rate_scale"):
+        assert fields[name].metadata.get("pytree_node") is False
+
+
+# ── config loading ────────────────────────────────────────────────────────────
+
+_KEYS = ("warming_rate_scale", "cooling_rate_scale")
+
+
+@pytest.mark.parametrize("key", _KEYS)
+def test_key_is_mandatory_when_thermal_enabled(key):
+    d = _uniform(-10.0)
+    del d["thermal"][key]
+    with pytest.raises(ValueError, match=key):
+        _params(d)
+
+
+@pytest.mark.parametrize("key", _KEYS)
+@pytest.mark.parametrize("bad", [0.0, -1.0, float("nan")])
+def test_non_positive_or_nan_is_rejected_naming_the_key(key, bad):
+    with pytest.raises(ValueError, match=rf"thermal\.{key} must be > 0"):
+        _params(_uniform(-10.0, **{key: bad}))
+
+
+@pytest.mark.parametrize("key", _KEYS)
+def test_scaled_stability_bound(key):
+    # k_exchange + k_loss = 0.05, so 20 is exactly on the bound and 20.5 is over.
+    _params(_uniform(-10.0, **{key: 20.0}))
+    with pytest.raises(ValueError, match=rf"thermal\.{key} \* "):
+        _params(_uniform(-10.0, **{key: 20.5}))
+
+
+def test_unscaled_stability_check_is_kept():
+    with pytest.raises(ValueError, match=r"thermal\.k_exchange \+ thermal\.k_loss must be <= 1"):
+        _params(_uniform(-10.0, k_exchange=0.9, k_loss=0.2))
+
+
+def test_keys_not_required_when_thermal_is_off():
+    d = _uniform(-10.0)
+    d["thermal"]["enabled"] = False
+    for k in _KEYS:
+        del d["thermal"][k]
+    p = _params(d)
+    assert p.thermal_warming_rate_scale == 1.0 and p.thermal_cooling_rate_scale == 1.0
+
+
+def test_every_thermal_enabled_config_ships_unit_scales():
+    """Loaded through `extends:` resolution, so inherited values count."""
+    paths = glob.glob(os.path.join(_ROOT, "configs", "**", "*.yaml"), recursive=True)
+    n = 0
+    for path in paths:
+        raw = yaml.safe_load(open(path)) or {}
+        th = raw.get("thermal")
+        if not (isinstance(th, dict) and th.get("enabled") is True):
+            continue
+        n += 1
+        cfg = load_env_config(path)
+        assert cfg.get_mandatory("thermal.warming_rate_scale") == 1.0, path
+        assert cfg.get_mandatory("thermal.cooling_rate_scale") == 1.0, path
+    assert n >= 3
