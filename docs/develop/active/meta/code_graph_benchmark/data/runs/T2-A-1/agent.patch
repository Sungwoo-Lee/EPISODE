diff --git a/tests/models/test_return_mode_mc_fixed.py b/tests/models/test_return_mode_mc_fixed.py
new file mode 100644
index 0000000..19b0a0a
--- /dev/null
+++ b/tests/models/test_return_mode_mc_fixed.py
@@ -0,0 +1,106 @@
+"""Tests for the MC_FIXED return mode of recurrent PPO (and its plain-PPO rejection).
+
+Plain-language context: MC_FIXED computes the same Monte-Carlo returns as MC, but then
+uses GAE-style bookkeeping: the raw (un-normalised) returns are the critic target and the
+advantages are normalised with the GAE branch's formula. MC and GAE must be unchanged.
+"""
+from types import SimpleNamespace
+
+import jax
+import jax.numpy as jnp
+import pytest
+
+from src.models import ppo_trainer, recurrent_ppo_trainer as rt
+
+GAMMA = 0.9
+T, N = 6, 3
+
+
+def _fake_trajectories():
+    k = jax.random.split(jax.random.PRNGKey(0), 4)
+    reward = jax.random.normal(k[0], (T, N))
+    value = jax.random.normal(k[1], (T, N))
+    done = jax.random.bernoulli(k[2], 0.3, (T, N))
+    term_reason = jax.random.randint(k[3], (T, N), 0, 5)
+    step_info = SimpleNamespace(termination_reason=term_reason)
+    traj = rt.Transition(
+        obs=jnp.zeros((T, N, 2)), action=jnp.zeros((T, N), jnp.int32), reward=reward,
+        done=done, log_prob=jnp.zeros((T, N)), value=value, mod_info=None,
+        step_info=step_info, next_value=jnp.zeros((T, N)),
+    )
+    return traj, jnp.linspace(-1.0, 1.0, N)
+
+
+def _run(monkeypatch, mode):
+    traj, boot = _fake_trajectories()
+    seen = {}
+    monkeypatch.setattr(
+        rt, "collect_trajectories",
+        lambda *a, **k: (traj, {"h": jnp.zeros((N, T, 1))}, "s", "h", "key", boot),
+    )
+    monkeypatch.setattr(rt, "_h_get_first_timestep", lambda h: None)
+
+    def fake_update(model, optimizer, batch, config):
+        seen["batch"] = batch
+        return 0.0, ()
+
+    monkeypatch.setattr(rt, "update_step", fake_update)
+    cfg = SimpleNamespace(rnn_type="LSTM", return_mode=mode, num_steps=T, num_epochs=1,
+                          gamma=GAMMA, gae_lambda=0.95)
+    rt.train_iteration(None, None, None, None, None, None, cfg)
+    terms = (traj.step_info.termination_reason >= 2).astype(traj.done.dtype)
+    raw = jax.vmap(rt.compute_mc_returns, in_axes=(1, 1, 1, 0, None), out_axes=1)(
+        traj.reward, traj.done, terms, boot, GAMMA)
+    return seen["batch"], raw, traj.value
+
+
+def test_mc_fixed_raw_targets_and_gae_style_advantages(monkeypatch):
+    batch, raw, value = _run(monkeypatch, "MC_FIXED")
+    assert jnp.array_equal(batch.targets, raw)
+    adv = raw - value
+    assert jnp.array_equal(batch.advantages, (adv - jnp.mean(adv)) / (jnp.std(adv) + 1e-8))
+
+
+def test_mc_unchanged(monkeypatch):
+    batch, raw, value = _run(monkeypatch, "MC")
+    norm = (raw - jnp.mean(raw)) / (jnp.std(raw) + 1e-7)
+    assert jnp.array_equal(batch.targets, norm)
+    assert jnp.array_equal(batch.advantages, norm - value)
+
+
+def test_mc_fixed_differs_from_mc(monkeypatch):
+    fixed, _, _ = _run(monkeypatch, "MC_FIXED")
+    mc, _, _ = _run(monkeypatch, "MC")
+    assert not jnp.allclose(fixed.targets, mc.targets)
+
+
+@pytest.mark.parametrize("raw,canon", [("MC", "MC"), (" mc_fixed ", "MC_FIXED"),
+                                       ("gae", "GAE"), ("Gae\n", "GAE")])
+def test_validate_accepts(raw, canon):
+    assert rt.validate_return_mode(raw) == canon
+
+
+@pytest.mark.parametrize("bad", ["MCFIXED", "", "mc-fixed", "TD", None])
+def test_validate_rejects_naming_all_modes(bad):
+    with pytest.raises(ValueError) as e:
+        rt.validate_return_mode(bad)
+    for m in ("MC", "MC_FIXED", "GAE"):
+        assert m in str(e.value)
+
+
+def test_train_iteration_rejects_invalid_mode():
+    cfg = SimpleNamespace(rnn_type="LSTM", return_mode="bogus")
+    with pytest.raises(ValueError, match="MC_FIXED"):
+        rt.train_iteration(None, None, None, None, None, None, cfg)
+
+
+def test_collect_trajectories_validates_mode():
+    """A typo must fail in collect_trajectories too, not silently take the MC path."""
+    with pytest.raises(ValueError):
+        rt.collect_trajectories(None, None, None, None, None, 1, return_mode="typo")
+
+
+def test_plain_ppo_rejects_mc_fixed():
+    cfg = SimpleNamespace(return_mode="MC_FIXED")
+    with pytest.raises(ValueError, match="MC_FIXED"):
+        ppo_trainer.train_iteration_ppo(None, None, None, None, None, cfg)
