diff --git a/tests/env/test_thermal_rate_scales.py b/tests/env/test_thermal_rate_scales.py
new file mode 100644
index 0000000..523f678
--- /dev/null
+++ b/tests/env/test_thermal_rate_scales.py
@@ -0,0 +1,217 @@
+"""Direction-dependent body-temperature speed: `thermal.warming_rate_scale` /
+`thermal.cooling_rate_scale`.
+
+In plain terms: the body can now warm and cool at different speeds. Each step the
+recurrence produces a change d (exchange with the cell, plus metabolic heat, minus
+physiological pull-back); the body moves by s*d, with s the warming scale when
+d > 0 and the cooling scale otherwise. Because the WHOLE step is scaled, d = 0 is
+untouched and every settling temperature stays where it was.
+"""
+import os
+
+os.environ.setdefault("JAX_PLATFORMS", "cpu")
+
+import copy
+import glob
+import sys
+
+import numpy as np
+import pytest
+import yaml
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+_ROOT = os.path.abspath(os.path.join(_HERE, "..", ".."))
+sys.path.insert(0, _ROOT)
+
+import jax
+
+from src.utils.config import Config
+from src.environment.config_loader import load_env_params
+from src.environment.core import jax_reset, jax_step
+
+THERMAL_CONFIG = os.path.join(
+    _ROOT, "configs", "environment", "experiment", "archive", "thermal", "campfire_world.yaml")
+DEFAULT_CONFIG = os.path.join(_ROOT, "configs", "environment", "default.yaml")
+REST = 4
+
+
+def _config(cell_temp, warming=1.0, cooling=1.0, **thermal_kw):
+    """Uniform-field thermal world (see test_thermal_body._uniform_field_config)."""
+    d = copy.deepcopy(yaml.safe_load(open(THERMAL_CONFIG)))
+    th = d["thermal"]
+    th["use_object_sources"] = False
+    th["use_random_spots"] = False
+    th["default_temp"] = [float(cell_temp), float(cell_temp)]
+    th["warming_rate_scale"] = warming
+    th["cooling_rate_scale"] = cooling
+    th.update(thermal_kw)
+    d["environment"]["entities"] = []
+    d["environment"]["obstacles"] = [
+        o for o in d["environment"]["obstacles"] if o.get("name") == "campfire"]
+    d["environment"]["resources"] = [
+        r for r in d["environment"]["resources"] if r.get("type") == "food"]
+    d["environment"]["max_steps"] = 2000
+    d["body"]["metabolic_cost"] = 0.0
+    return d
+
+
+def _params(d):
+    return load_env_params(Config(d))
+
+
+def _traj(params, n):
+    state = jax_reset(params, jax.random.PRNGKey(0))
+    out = [float(state.body_temp)]
+    for _ in range(n):
+        state, _, done, _ = jax_step(state, REST, params)
+        out.append(float(state.body_temp))
+        if bool(done):
+            break
+    return np.array(out)
+
+
+# ── params exposure ───────────────────────────────────────────────────────────
+
+def test_params_carry_the_scales_as_static_fields():
+    p = _params(_config(-10.0, warming=1.5, cooling=0.5))
+    assert p.thermal_warming_rate_scale == 1.5
+    assert p.thermal_cooling_rate_scale == 0.5
+    # static: not pytree leaves
+    import dataclasses
+    fields = {f.name: f for f in dataclasses.fields(p)}
+    for name in ("thermal_warming_rate_scale", "thermal_cooling_rate_scale"):
+        assert fields[name].metadata.get("pytree_node") is False
+
+
+def test_thermal_off_params_are_inert_ones():
+    d = yaml.safe_load(open(DEFAULT_CONFIG))
+    d["thermal"].pop("warming_rate_scale")
+    d["thermal"].pop("cooling_rate_scale")
+    p = _params(d)              # thermal off: keys are not read
+    assert p.thermal_warming_rate_scale == 1.0
+    assert p.thermal_cooling_rate_scale == 1.0
+
+
+# ── load-time validation ──────────────────────────────────────────────────────
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+def test_missing_key_is_refused_and_named(key):
+    d = _config(-10.0)
+    del d["thermal"][key]
+    with pytest.raises(ValueError, match=key):
+        _params(d)
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+@pytest.mark.parametrize("bad", [0.0, -1.0, float("nan")])
+def test_non_positive_or_nan_is_refused_and_named(key, bad):
+    d = _config(-10.0)
+    d["thermal"][key] = bad
+    with pytest.raises(ValueError, match=f"thermal.{key}"):
+        _params(d)
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+def test_monotone_bound_is_refused_and_named(key):
+    d = _config(-10.0)          # k_exchange + k_loss = 0.05
+    d["thermal"][key] = 20.01
+    with pytest.raises(ValueError, match=f"thermal.{key}"):
+        _params(d)
+    d["thermal"][key] = 20.0    # boundary: scale*(k_ex+k_loss) == 1 is allowed
+    _params(d)
+
+
+# ── behaviour ─────────────────────────────────────────────────────────────────
+
+def test_cooling_step_is_scaled_whole_and_warming_scale_is_ignored():
+    # cell at -10, body starts at 0 -> d < 0 on step 1
+    k_ex, k_loss = 0.04, 0.01
+    d0 = k_ex * (-10.0 - 0.0) - k_loss * 0.0
+    base = _traj(_params(_config(-10.0)), 1)
+    fast = _traj(_params(_config(-10.0, warming=3.0, cooling=2.0)), 1)
+    np.testing.assert_allclose(base[1], d0, rtol=1e-5)
+    np.testing.assert_allclose(fast[1], 2.0 * d0, rtol=1e-5)
+
+
+def test_warming_step_is_scaled_whole_and_cooling_scale_is_ignored():
+    k_ex = 0.04
+    d0 = k_ex * 10.0
+    p = _params(_config(10.0, warming=3.0, cooling=0.5))
+    np.testing.assert_allclose(_traj(p, 1)[1], 3.0 * d0, rtol=1e-5)
+
+
+def test_settling_temperature_is_unchanged():
+    # T* = k_ex*field / (k_ex + k_loss) = -8 for a -10 cell
+    for w, c in [(1.0, 1.0), (2.0, 0.5), (0.5, 3.0)]:
+        t = _traj(_params(_config(-10.0, warming=w, cooling=c)), 1500)[-1]
+        np.testing.assert_allclose(t, -8.0, atol=1e-2)
+
+
+def test_equal_non_unit_scales_are_a_uniform_speed_change():
+    a = _traj(_params(_config(-10.0)), 5)
+    b = _traj(_params(_config(-10.0, warming=2.0, cooling=2.0)), 5)
+    assert not np.allclose(a[1:], b[1:])
+    np.testing.assert_allclose(b[1], 2.0 * a[1], rtol=1e-5)
+
+
+def test_unit_scales_use_the_original_expression():
+    """1.0/1.0 traces the original, smaller program; any other pair adds the
+    sign-select and the multiply."""
+    p1 = _params(_config(-10.0))
+    p2 = _params(_config(-10.0, warming=1.0, cooling=1.0000001))
+    state = jax_reset(p1, jax.random.PRNGKey(0))
+    j1 = jax.make_jaxpr(lambda s: jax_step(s, REST, p1))(state)
+    j2 = jax.make_jaxpr(lambda s: jax_step(s, REST, p2))(state)
+    assert len(j1.jaxpr.eqns) < len(j2.jaxpr.eqns) or str(j1) != str(j2)
+    assert str(j1).count("select_n") < str(j2).count("select_n")
+
+
+def test_metabolic_drain_is_not_scaled():
+    a = _params(_config(-10.0, metabolic_coupling=True, metabolic_coupling_rate=5.0))
+    b = _params(_config(-10.0, warming=2.0, cooling=2.0,
+                        metabolic_coupling=True, metabolic_coupling_rate=5.0))
+    # First step: the drain reads the PRE-step body temperature, which is
+    # identical (the setpoint), so nutrition must be identical too.
+    sa = jax_reset(a, jax.random.PRNGKey(0))
+    sb = jax_reset(b, jax.random.PRNGKey(0))
+    sa, *_ = jax_step(sa, REST, a)
+    sb, *_ = jax_step(sb, REST, b)
+    np.testing.assert_allclose(float(sa.nutrition), float(sb.nutrition), rtol=1e-6)
+    # Second step: pre-step temperatures differ (the body moved at different
+    # speeds), and the drain follows k_loss*(T - setpoint) of the ACTUAL
+    # temperature, not a scaled version of it.
+    ta, tb = float(sa.body_temp), float(sb.body_temp)
+    assert ta != tb
+    na0, nb0 = float(sa.nutrition), float(sb.nutrition)
+    sa, *_ = jax_step(sa, REST, a)
+    sb, *_ = jax_step(sb, REST, b)
+    drain_a = na0 - float(sa.nutrition)
+    drain_b = nb0 - float(sb.nutrition)
+    np.testing.assert_allclose(drain_b - drain_a, 5.0 * 0.01 * (abs(tb) - abs(ta)),
+                               rtol=1e-3, atol=1e-6)
+
+
+# ── shipped configs ───────────────────────────────────────────────────────────
+
+def _thermal_enabled_configs():
+    out = []
+    for f in sorted(glob.glob(os.path.join(_ROOT, "configs", "**", "*.yaml"), recursive=True)):
+        try:
+            d = yaml.safe_load(open(f))
+        except yaml.YAMLError:
+            continue
+        if isinstance(d, dict) and isinstance(d.get("thermal"), dict) \
+                and d["thermal"].get("enabled") is True:
+            out.append(f)
+    return out
+
+
+def test_every_thermal_enabled_config_ships_unit_scales():
+    files = _thermal_enabled_configs()
+    assert files
+    default = yaml.safe_load(open(DEFAULT_CONFIG))["thermal"]
+    for f in files:
+        th = yaml.safe_load(open(f))["thermal"]
+        merged = {**default, **th} if "extends" in yaml.safe_load(open(f)) else th
+        assert merged["warming_rate_scale"] == 1.0, f
+        assert merged["cooling_rate_scale"] == 1.0, f
