diff --git a/tests/models/test_return_mode_mc_fixed.py b/tests/models/test_return_mode_mc_fixed.py
new file mode 100644
index 0000000..a5a7846
--- /dev/null
+++ b/tests/models/test_return_mode_mc_fixed.py
@@ -0,0 +1,119 @@
+"""Tests for the MC_FIXED return mode of Recurrent PPO and `validate_return_mode`.
+
+Plain-language context: Recurrent PPO turns a rollout into (a) a critic target — what the
+value head is trained towards — and (b) advantages — how much better an action was than the
+critic expected. "MC" uses Monte-Carlo returns and normalises the RETURNS (so the critic target
+is normalised); "GAE" uses generalised advantage estimation with RAW targets. "MC_FIXED" is a
+comparison mode: the same Monte-Carlo returns as "MC", but with GAE's bookkeeping (raw returns
+as the critic target, normalised advantages with a 1e-8 epsilon).
+"""
+from types import SimpleNamespace
+
+import jax
+import jax.numpy as jnp
+import pytest
+
+from src.models import recurrent_ppo_trainer as trainer
+from src.models import ppo_trainer
+from src.models.recurrent_ppo_trainer import (
+    StepInfo, Transition, compute_mc_returns, validate_return_mode, train_iteration,
+)
+
+T, B = 6, 3
+GAMMA = 0.9
+
+
+@pytest.mark.parametrize("raw,canon", [
+    ("MC", "MC"), ("mc", "MC"), ("Mc_Fixed", "MC_FIXED"), ("  mc_fixed\n", "MC_FIXED"),
+    ("gae", "GAE"), (" GAE ", "GAE"),
+])
+def test_validate_accepts_and_canonicalises(raw, canon):
+    assert validate_return_mode(raw) == canon
+
+
+@pytest.mark.parametrize("bad", ["", "MCFIXED", "MC-FIXED", "gae2", "TD", None, 3])
+def test_validate_rejects_with_all_legal_modes_named(bad):
+    with pytest.raises(ValueError) as exc:
+        validate_return_mode(bad)
+    for legal in ("MC", "MC_FIXED", "GAE"):
+        assert legal in str(exc.value)
+
+
+def _fake_rollout():
+    k = jax.random.PRNGKey(0)
+    kr, kv, kn = jax.random.split(k, 3)
+    reward = jax.random.normal(kr, (T, B))
+    value = jax.random.normal(kv, (T, B))
+    done = jnp.zeros((T, B), bool).at[2, 0].set(True).at[T - 1, 1].set(True)
+    term_reason = jnp.zeros((T, B), jnp.int32).at[2, 0].set(1).at[T - 1, 1].set(2)
+    step_info = StepInfo(*([jnp.zeros((T, B))] * 14), termination_reason=term_reason,
+                         dist_per_neutral=None, dist_per_predator=None, agent_in_bush=None)
+    trans = Transition(
+        obs=jnp.zeros((T, B, 2)), action=jnp.zeros((T, B), jnp.int32), reward=reward, done=done,
+        log_prob=jnp.zeros((T, B)), value=value, mod_info=None, step_info=step_info,
+        next_value=jnp.zeros((T, B)),
+    )
+    h_states = jnp.zeros((T, B, 2))
+    bootstrap = jax.random.normal(kn, (B,))
+    return trans, h_states, bootstrap
+
+
+def _run(monkeypatch, mode):
+    trans, h_states, bootstrap = _fake_rollout()
+    seen = {}
+    monkeypatch.setattr(trainer, "collect_trajectories",
+                        lambda *a, **kw: (trans, h_states, None, None, None, bootstrap))
+
+    def fake_update(model, optimizer, batch, config):
+        seen["batch"] = batch
+        return 0.0, ()
+
+    monkeypatch.setattr(trainer, "update_step", fake_update)
+    cfg = SimpleNamespace(rnn_type="LSTM", return_mode=mode, num_steps=T, gamma=GAMMA,
+                          gae_lambda=0.95, num_epochs=1)
+    train_iteration(None, None, None, None, None, None, cfg)
+    return seen["batch"], trans, bootstrap
+
+
+def test_mc_fixed_uses_raw_mc_returns_and_gae_style_advantage_norm(monkeypatch):
+    batch, trans, bootstrap = _run(monkeypatch, "mc_fixed")
+    terminateds = (trans.step_info.termination_reason >= 2).astype(trans.done.dtype)
+    raw = jax.vmap(compute_mc_returns, in_axes=(1, 1, 1, 0, None), out_axes=1)(
+        trans.reward, trans.done, terminateds, bootstrap, GAMMA)
+    assert jnp.array_equal(batch.targets, raw)
+    adv = raw - trans.value
+    expected = (adv - jnp.mean(adv)) / (jnp.std(adv) + 1e-8)
+    assert jnp.array_equal(batch.advantages, expected)
+
+
+def test_mc_unchanged_normalises_returns(monkeypatch):
+    batch, trans, bootstrap = _run(monkeypatch, "MC")
+    terminateds = (trans.step_info.termination_reason >= 2).astype(trans.done.dtype)
+    raw = jax.vmap(compute_mc_returns, in_axes=(1, 1, 1, 0, None), out_axes=1)(
+        trans.reward, trans.done, terminateds, bootstrap, GAMMA)
+    norm = (raw - jnp.mean(raw)) / (jnp.std(raw) + 1e-7)
+    assert jnp.array_equal(batch.targets, norm)
+    assert jnp.array_equal(batch.advantages, norm - trans.value)
+
+
+def test_gae_unchanged(monkeypatch):
+    batch, trans, _ = _run(monkeypatch, "GAE")
+    terminateds = (trans.step_info.termination_reason >= 2).astype(trans.done.dtype)
+    adv = jax.vmap(trainer.compute_gae, in_axes=(1, 1, 1, 1, 1, None, None), out_axes=1)(
+        trans.reward, trans.value, trans.next_value, trans.done, terminateds, GAMMA, 0.95)
+    assert jnp.array_equal(batch.targets, adv + trans.value)
+    assert jnp.array_equal(batch.advantages, (adv - jnp.mean(adv)) / (jnp.std(adv) + 1e-8))
+
+
+def test_train_iteration_rejects_invalid_mode():
+    cfg = SimpleNamespace(rnn_type="LSTM", return_mode="mc_fxied", num_steps=T, gamma=GAMMA,
+                          gae_lambda=0.95, num_epochs=1)
+    with pytest.raises(ValueError, match="MC_FIXED"):
+        train_iteration(None, None, None, None, None, None, cfg)
+
+
+def test_plain_ppo_rejects_mc_fixed():
+    cfg = SimpleNamespace(return_mode="MC_FIXED", num_steps=T, gamma=GAMMA,
+                          gae_lambda=0.95, num_epochs=1)
+    with pytest.raises(ValueError, match="MC_FIXED"):
+        ppo_trainer.train_iteration_ppo(None, None, None, None, None, cfg)
