+def _gae_advantages(traj):
+    from src.models.recurrent_ppo_trainer import compute_gae
+    terminateds = (traj.step_info.termination_reason >= 2).astype(traj.done.dtype)
+    return jax.vmap(compute_gae, in_axes=(1, 1, 1, 1, 1, None, None), out_axes=1)(
+        traj.reward, traj.value, traj.next_value, traj.done, terminateds, GAMMA, 0.95)
+
+
+def test_mc_raw_is_mc_fixed_without_advantage_normalisation(monkeypatch):
+    batch, mode, traj, boot = _capture_batch("MC_RAW", monkeypatch)
+    expected = _expected_returns(traj, boot)
+    assert mode == "MC_RAW"
+    assert jnp.array_equal(batch.targets, expected)
+    assert jnp.array_equal(batch.advantages, expected - traj.value)
+    assert abs(float(jnp.std(batch.advantages)) - 1.0) > 1e-3
+
+
+def test_gae_norm_zscores_target_and_leaves_advantage_as_residual(monkeypatch):
+    batch, mode, traj, _ = _capture_batch("GAE_NORM", monkeypatch)
+    assert mode == "GAE_NORM"
+    raw_target = _gae_advantages(traj) + traj.value
+    expected = (raw_target - jnp.mean(raw_target)) / (jnp.std(raw_target) + 1e-7)
+    assert jnp.allclose(batch.targets, expected, atol=1e-6)
+    assert jnp.allclose(batch.advantages, batch.targets - traj.value, atol=1e-6)
+    assert float(jnp.mean(batch.targets)) == pytest.approx(0.0, abs=1e-5)
+    assert abs(float(jnp.std(batch.advantages)) - 1.0) > 1e-3
