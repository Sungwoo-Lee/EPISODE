diff --git a/tests/env/test_directional_sensors.py b/tests/env/test_directional_sensors.py
index 648ec37..594aeed 100644
--- a/tests/env/test_directional_sensors.py
+++ b/tests/env/test_directional_sensors.py
@@ -283,3 +283,43 @@ def test_nothing_blocks_sight_by_default():
     p = params()
     for arr in (p.res_blocks_sight, p.animal_blocks_sight, p.obs_blocks_sight):
         assert not bool(np.asarray(arr).any())
+
+
+# ------------------------------------------------- blur knobs: conditional ---
+
+_BLUR_KNOBS = ('radial_scale', 'anisotropy', 'sigma_floor')
+
+
+def _default_without_blur_knobs(**overrides):
+    c = Config.load_yaml(DEFAULT)
+    for k in _BLUR_KNOBS:
+        del c.to_dict()['sensory'][f'visual_blur_{k}']
+    for k, v in overrides.items():
+        c.set(k, v)
+    return c
+
+
+def test_blur_off_loads_without_the_knobs():
+    p = load_env_params(_default_without_blur_knobs())
+    assert p.visual_blur_enabled is False
+
+
+@pytest.mark.parametrize('knob', _BLUR_KNOBS)
+def test_blur_on_requires_each_knob(knob):
+    c = _default_without_blur_knobs(**{'sensory.visual_blur_enabled': True})
+    for other in _BLUR_KNOBS:
+        if other != knob:
+            c.set(f'sensory.visual_blur_{other}', 1.0)
+    with pytest.raises(ValueError, match=f'visual_blur_{knob}'):
+        load_env_params(c)
+
+
+@pytest.mark.parametrize('bad, key', [
+    ({'sensory.visual_blur_anisotropy': 0.0}, 'anisotropy'),
+    ({'sensory.visual_blur_sigma_floor': 0.0, 'sensory.visual_blur_radial_scale': 0.0},
+     'sigma_floor'),
+    ({'sensory.visual_blur_radial_scale': -0.1}, 'radial_scale'),
+])
+def test_blur_on_validates_knob_values(bad, key):
+    with pytest.raises(ValueError, match=key):
+        params(**{'sensory.visual_blur_enabled': True, **bad})
