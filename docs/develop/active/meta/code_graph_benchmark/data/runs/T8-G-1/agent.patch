+
+
+# ---------------------------------------------------------------------------
+# (f) GAE_NORM and MC_RAW complete the estimator x scaling-convention cross
+# ---------------------------------------------------------------------------
+
+def test_legal_return_modes_order():
+    assert rpt.LEGAL_RETURN_MODES == ("MC", "MC_FIXED", "GAE", "GAE_NORM", "MC_RAW")
+
+
+@pytest.mark.parametrize("good,canonical", [
+    ("gae_norm", "GAE_NORM"), ("GAE_NORM", "GAE_NORM"), ("Gae_Norm", "GAE_NORM"),
+    ("mc_raw", "MC_RAW"), ("MC_RAW", "MC_RAW"), (" mc_raw ", "MC_RAW"),
+])
+def test_new_modes_accepted_case_insensitively(good, canonical):
+    assert validate_return_mode(good) == canonical
+
+
+def test_invalid_return_mode_message_names_every_legal_mode(monkeypatch):
+    with pytest.raises(ValueError) as exc:
+        validate_return_mode("nope")
+    for legal in rpt.LEGAL_RETURN_MODES:
+        assert legal in str(exc.value)
+    with pytest.raises(ValueError) as exc:
+        _capture_batch("nope", monkeypatch)
+    for legal in rpt.LEGAL_RETURN_MODES:
+        assert legal in str(exc.value)
+
+
+def test_mc_raw_is_mc_fixed_without_advantage_normalisation(monkeypatch):
+    raw, mode, traj, boot = _capture_batch("MC_RAW", monkeypatch)
+    assert mode == "MC_RAW"
+    expected = _expected_returns(traj, boot)
+    assert jnp.allclose(raw.targets, expected, atol=1e-6)
+    assert jnp.allclose(raw.advantages, expected - traj.value, atol=1e-6)
+
+
+def test_gae_norm_zscores_target_and_uses_unrescaled_residual(monkeypatch):
+    batch, mode, traj, _ = _capture_batch("GAE_NORM", monkeypatch)
+    gae_batch, _, _, _ = _capture_batch("GAE", monkeypatch)
+    assert mode == "GAE_NORM"
+    raw_target = gae_batch.targets  # advantage + V, un-normalised
+    expected = (raw_target - jnp.mean(raw_target)) / (jnp.std(raw_target) + 1e-7)
+    assert jnp.allclose(batch.targets, expected, atol=1e-5)
+    assert jnp.allclose(batch.advantages, batch.targets - traj.value, atol=1e-6)
+
+
+@pytest.mark.integration
+@pytest.mark.parametrize("mode,expect_per_step_next_value", [
+    ("GAE_NORM", True), ("MC_RAW", False),
+])
+def test_new_modes_bootstrap_path_selection(mode, expect_per_step_next_value, tiny_env_and_model):
+    model, params, state = tiny_env_and_model
+    h = model.initial_state(2)
+    traj, _, _, _, _, bootstrap_value = rpt.collect_trajectories(
+        model, params, state, h, jax.random.PRNGKey(3), 4,
+        rnn_type="GRU", return_mode=mode)
+    assert bool(jnp.any(traj.next_value != 0.0)) == expect_per_step_next_value
+    assert bootstrap_value.shape == (2,)
