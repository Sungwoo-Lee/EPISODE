+++ b/tests/models/test_mc_fixed_mode.py
@@ -250,3 +250,62 @@ def test_bootstrap_path_selection(mode, expect_per_step_next_value, tiny_env_and
     assert per_step_ran == expect_per_step_next_value
     # Every mode still returns a usable window-edge bootstrap of shape (num_envs,).
