+# ------------------------------------------------ blur knobs are conditional-mandatory ---
+
+_BLUR_KNOBS = ('radial_scale', 'anisotropy', 'sigma_floor')
+
+
+def _blur_config(enabled, drop=(), **overrides):
+    c = Config.load_yaml(DEFAULT)
+    c.set('sensory.visual_blur_enabled', enabled)
+    for k, v in overrides.items():
+        c.set(k, v)
+    d = c.to_dict()
+    for knob in drop:
+        del d['sensory'][f'visual_blur_{knob}']
+    return Config(d)
+
+
+def test_blur_off_loads_without_the_knobs():
+    p = load_env_params(_blur_config(False, drop=_BLUR_KNOBS))
+    assert p.visual_blur_enabled is False
+
+
+def test_blur_off_does_not_validate_the_knobs():
+    load_env_params(_blur_config(False, **{'sensory.visual_blur_anisotropy': 0.0}))
+
+
+@pytest.mark.parametrize('knob', _BLUR_KNOBS)
+def test_blur_on_missing_knob_raises(knob):
+    with pytest.raises(ValueError, match=f'visual_blur_{knob}'):
+        load_env_params(_blur_config(True, drop=(knob,)))
+
+
+@pytest.mark.parametrize('bad, knob', [
+    ({'sensory.visual_blur_anisotropy': 0.0}, 'anisotropy'),
+    ({'sensory.visual_blur_sigma_floor': 0.0,
+      'sensory.visual_blur_radial_scale': 0.0}, 'sigma_floor'),
+    ({'sensory.visual_blur_radial_scale': -0.1}, 'radial_scale'),
+])
+def test_blur_on_still_validates_the_knobs(bad, knob):
+    with pytest.raises(ValueError, match=f'visual_blur_{knob}'):
+        load_env_params(_blur_config(True, **bad))
