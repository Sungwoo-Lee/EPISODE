+# ---------------------------------------------------------------------------
+# GAE_NORM / MC_RAW: completing the estimator x scaling cross
+# ---------------------------------------------------------------------------
+
+def _expected_gae(traj):
+    terminateds = (traj.step_info.termination_reason >= 2).astype(traj.done.dtype)
+    return jax.vmap(rpt.compute_gae, in_axes=(1, 1, 1, 1, 1, None, None), out_axes=1)(
+        traj.reward, traj.value, traj.next_value, traj.done, terminateds, GAMMA, _Cfg.gae_lambda)
+
+
+def test_gae_norm_zscores_target_and_leaves_advantage_as_residual(monkeypatch):
+    batch, _, traj, _ = _capture_batch("GAE_NORM", monkeypatch)
+    raw_target = _expected_gae(traj) + traj.value
+    expected = (raw_target - jnp.mean(raw_target)) / (jnp.std(raw_target) + 1e-7)
+    assert jnp.allclose(batch.targets, expected, atol=1e-5)
+    assert jnp.allclose(batch.advantages, batch.targets - traj.value, atol=1e-6)
+    assert abs(float(jnp.std(batch.advantages)) - 1.0) > 1e-3
+
+
+def test_mc_raw_has_raw_target_and_raw_advantage(monkeypatch):
+    batch, _, traj, boot = _capture_batch("MC_RAW", monkeypatch)
+    expected = _expected_returns(traj, boot)
+    assert jnp.allclose(batch.targets, expected, atol=1e-6)
+    assert jnp.allclose(batch.advantages, expected - traj.value, atol=1e-6)
+    assert abs(float(jnp.std(batch.advantages)) - 1.0) > 1e-3
+
+
