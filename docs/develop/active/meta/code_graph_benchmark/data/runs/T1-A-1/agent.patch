diff --git a/tests/env/test_thermal_rate_scales.py b/tests/env/test_thermal_rate_scales.py
new file mode 100644
index 0000000..1515d9f
--- /dev/null
+++ b/tests/env/test_thermal_rate_scales.py
@@ -0,0 +1,150 @@
+"""Direction-dependent body-temperature speed: `thermal.warming_rate_scale` and
+`thermal.cooling_rate_scale`.
+
+In plain terms: the body can now warm and cool at different speeds. The whole
+per-step change d is multiplied by the warming scale when d > 0 and by the cooling
+scale otherwise, so every settling temperature stays where it was. Exactly 1.0 / 1.0
+must leave today's computation (and compiled step) untouched.
+"""
+import os
+
+os.environ.setdefault("JAX_PLATFORMS", "cpu")
+
+import copy
+import sys
+
+import numpy as np
+import pytest
+import yaml
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+_ROOT = os.path.abspath(os.path.join(_HERE, "..", ".."))
+sys.path.insert(0, _ROOT)
+
+import jax
+
+from src.utils.config import Config
+from src.environment.config_loader import load_env_params
+from src.environment.core import jax_reset, jax_step
+
+CONFIGS = [
+    os.path.join(_ROOT, "configs", "environment", "experiment", "archive", "thermal", n)
+    for n in ("campfire_world.yaml", "campfire_world_body_temp_hidden.yaml")
+]
+THERMAL_CONFIG = CONFIGS[0]
+REST = 4
+
+
+def _dict(warm=1.0, cool=1.0, cell_temp=None):
+    d = copy.deepcopy(yaml.safe_load(open(THERMAL_CONFIG)))
+    d["thermal"]["warming_rate_scale"] = warm
+    d["thermal"]["cooling_rate_scale"] = cool
+    if cell_temp is not None:
+        d["thermal"]["use_object_sources"] = False
+        d["thermal"]["use_random_spots"] = False
+        d["thermal"]["default_temp"] = [float(cell_temp), float(cell_temp)]
+        d["environment"]["entities"] = []
+        d["environment"]["obstacles"] = [
+            o for o in d["environment"]["obstacles"] if o.get("name") == "campfire"]
+        d["environment"]["resources"] = [
+            r for r in d["environment"]["resources"] if r.get("type") == "food"]
+        d["environment"]["max_steps"] = 500
+        d["body"]["metabolic_cost"] = 0.0
+    return d
+
+
+def _params(d):
+    return load_env_params(Config(d))
+
+
+def _first_step_delta(params, body_temp):
+    state = jax_reset(params, jax.random.PRNGKey(0))
+    state = state.replace(body_temp=jax.numpy.float32(body_temp))
+    new_state, _, _, _ = jax_step(state, REST, params)
+    return float(new_state.body_temp) - float(body_temp)
+
+
+@pytest.mark.parametrize("path", CONFIGS)
+def test_shipped_thermal_worlds_are_one_one(path):
+    d = yaml.safe_load(open(path))
+    assert d["thermal"]["warming_rate_scale"] == 1.0
+    assert d["thermal"]["cooling_rate_scale"] == 1.0
+    p = _params(d)
+    assert p.thermal_warming_rate_scale == 1.0
+    assert p.thermal_cooling_rate_scale == 1.0
+
+
+def test_default_yaml_and_basic_campfire_carry_one_one():
+    default = yaml.safe_load(open(os.path.join(_ROOT, "configs", "environment", "default.yaml")))
+    assert default["thermal"]["warming_rate_scale"] == 1.0
+    assert default["thermal"]["cooling_rate_scale"] == 1.0
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+def test_missing_key_raises_when_thermal_enabled(key):
+    d = _dict()
+    del d["thermal"][key]
+    with pytest.raises(ValueError, match=key):
+        _params(d)
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+@pytest.mark.parametrize("bad", [0.0, -1.0, float("nan")])
+def test_non_positive_or_nan_raises_naming_key(key, bad):
+    d = _dict()
+    d["thermal"][key] = bad
+    with pytest.raises(ValueError, match=key):
+        _params(d)
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+def test_monotone_bound_raises_naming_key(key):
+    d = _dict()
+    k = d["thermal"]["k_exchange"] + d["thermal"]["k_loss"]
+    d["thermal"][key] = 1.0 / k * 1.01
+    with pytest.raises(ValueError, match=key):
+        _params(d)
+    d["thermal"][key] = 1.0 / k          # boundary is allowed
+    _params(d)
+
+
+def test_thermal_off_needs_neither_key():
+    d = _dict()
+    d["thermal"]["enabled"] = False
+    del d["thermal"]["warming_rate_scale"]
+    del d["thermal"]["cooling_rate_scale"]
+    p = _params(d)
+    assert p.thermal_warming_rate_scale == 1.0
+    assert p.thermal_cooling_rate_scale == 1.0
+
+
+def test_scales_are_static_fields():
+    p = _params(_dict(2.0, 3.0))
+    leaves = jax.tree_util.tree_leaves(p)
+    assert 2.0 not in [l for l in leaves if isinstance(l, float)]
+    assert p.thermal_warming_rate_scale == 2.0
+    assert p.thermal_cooling_rate_scale == 3.0
+
+
+def test_whole_step_scaled_by_direction():
+    base = _params(_dict(1.0, 1.0, cell_temp=-20.0))
+    scaled = _params(_dict(2.0, 3.0, cell_temp=-20.0))
+    # Cold cell: body at setpoint 0 cools (d < 0) -> cooling scale.
+    d_cool = _first_step_delta(base, 0.0)
+    assert d_cool < 0
+    assert _first_step_delta(scaled, 0.0) == pytest.approx(3.0 * d_cool, rel=1e-5)
+    # Body far below the cell: warms (d > 0) -> warming scale.
+    d_warm = _first_step_delta(base, -30.0)
+    assert d_warm > 0
+    assert _first_step_delta(scaled, -30.0) == pytest.approx(2.0 * d_warm, rel=1e-5)
+
+
+def test_fixed_point_unchanged():
+    def settle(p, n=600):
+        state = jax_reset(p, jax.random.PRNGKey(0))
+        for _ in range(n):
+            state, _, done, _ = jax_step(state, REST, p)
+        return float(state.body_temp)
+    a = settle(_params(_dict(1.0, 1.0, cell_temp=-10.0)))
+    b = settle(_params(_dict(1.5, 4.0, cell_temp=-10.0)))
+    assert b == pytest.approx(a, abs=1e-3)
