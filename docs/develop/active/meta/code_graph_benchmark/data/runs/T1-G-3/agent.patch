diff --git a/tests/env/test_thermal_rate_scales.py b/tests/env/test_thermal_rate_scales.py
new file mode 100644
index 0000000..5e8b1f5
--- /dev/null
+++ b/tests/env/test_thermal_rate_scales.py
@@ -0,0 +1,151 @@
+"""`thermal.warming_rate_scale` / `thermal.cooling_rate_scale`.
+
+The whole per-step body-temperature change `d` is multiplied by the warming scale
+when d > 0 and by the cooling scale otherwise. Checked here:
+
+* load-time validation (missing key, non-positive, NaN, monotonicity bound);
+* the values reach `EnvParams` as static fields;
+* both scales 1.0 reproduces the unscaled recurrence exactly;
+* the settling temperature is unchanged by the scales, only the speed differs;
+"""
+import copy
+import os
+import sys
+
+import numpy as np
+import pytest
+import yaml
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+_ROOT = os.path.abspath(os.path.join(_HERE, "..", ".."))
+sys.path.insert(0, _ROOT)
+sys.path.insert(0, _HERE)
+
+import jax
+
+from src.utils.config import Config
+from src.environment.config_loader import load_env_params
+from src.environment.core import jax_reset, jax_step
+from thermal_sandbox_oracle import body_traj
+
+THERMAL_CONFIG = os.path.join(
+    _ROOT, "configs", "environment", "experiment", "archive", "thermal", "campfire_world.yaml")
+REST = 4
+
+
+def _config(cell_temp=None, **thermal):
+    d = copy.deepcopy(yaml.safe_load(open(THERMAL_CONFIG)))
+    if cell_temp is not None:
+        d["thermal"]["use_object_sources"] = False
+        d["thermal"]["use_random_spots"] = False
+        d["thermal"]["default_temp"] = [float(cell_temp), float(cell_temp)]
+        d["environment"]["entities"] = []
+        d["environment"]["obstacles"] = [
+            o for o in d["environment"]["obstacles"] if o.get("name") == "campfire"]
+        d["environment"]["resources"] = [
+            r for r in d["environment"]["resources"] if r.get("type") == "food"]
+        d["environment"]["max_steps"] = 500
+        d["body"]["metabolic_cost"] = 0.0
+    d["thermal"].update(thermal)
+    return d
+
+
+def _params(d):
+    return load_env_params(Config(d))
+
+
+def _traj(params, n, start=None):
+    state = jax_reset(params, jax.random.PRNGKey(0))
+    if start is not None:
+        state = state.replace(body_temp=np.float32(start))
+    out = [float(state.body_temp)]
+    for _ in range(n):
+        state, _r, done, _i = jax_step(state, REST, params)
+        out.append(float(state.body_temp))
+        if bool(done):
+            break
+    return np.array(out)
+
+
+# ── validation ────────────────────────────────────────────────────────────────
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+def test_missing_key_is_refused(key):
+    d = _config()
+    del d["thermal"][key]
+    with pytest.raises(ValueError, match=key):
+        _params(d)
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+@pytest.mark.parametrize("bad", [0.0, -1.0, float("nan")])
+def test_non_positive_or_nan_is_refused(key, bad):
+    with pytest.raises(ValueError, match=key):
+        _params(_config(**{key: bad}))
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+def test_monotonicity_bound_is_refused(key):
+    # k_exchange + k_loss = 0.05, so scale 20 is the largest allowed and 20.5 is not.
+    _params(_config(**{key: 20.0}))
+    with pytest.raises(ValueError, match=key):
+        _params(_config(**{key: 20.5}))
+
+
+def test_unscaled_stability_check_is_kept():
+    with pytest.raises(ValueError, match="k_exchange"):
+        _params(_config(k_exchange=0.9, k_loss=0.2))
+
+
+def test_thermal_off_needs_no_scales():
+    d = _config()
+    d["thermal"]["enabled"] = False
+    del d["thermal"]["warming_rate_scale"], d["thermal"]["cooling_rate_scale"]
+    p = _params(d)
+    assert (p.thermal_warming_rate_scale, p.thermal_cooling_rate_scale) == (1.0, 1.0)
+
+
+def test_exposed_as_static_fields():
+    p = _params(_config(warming_rate_scale=2.0, cooling_rate_scale=0.5))
+    assert p.thermal_warming_rate_scale == 2.0
+    assert p.thermal_cooling_rate_scale == 0.5
+    leaves = jax.tree_util.tree_leaves(p)
+    assert 2.0 not in [l for l in leaves if isinstance(l, float)]
+
+
+# ── dynamics ──────────────────────────────────────────────────────────────────
+
+def test_unit_scales_match_unscaled_recurrence_exactly():
+    p = _params(_config(cell_temp=-10.0))
+    assert (p.thermal_warming_rate_scale, p.thermal_cooling_rate_scale) == (1.0, 1.0)
+    traj = _traj(p, 60)
+    oracle = body_traj([-10.0] * 60, T0=float(traj[0]))
+    np.testing.assert_allclose(traj[1:], np.asarray(oracle)[1:len(traj)], rtol=1e-5, atol=1e-5)
+
+
+@pytest.mark.parametrize("warm,cool", [(1.0, 2.0), (2.0, 1.0), (0.5, 0.5), (2.0, 2.0)])
+def test_scaled_step_matches_oracle_and_same_fixed_point(warm, cool):
+    cell = -10.0
+    p = _params(_config(cell_temp=cell, warming_rate_scale=warm, cooling_rate_scale=cool))
+    traj = _traj(p, 300)
+    k_ex, k_loss = 0.04, 0.01
+    t = float(traj[0])
+    for i in range(1, len(traj)):
+        d = k_ex * (cell - t) - k_loss * (t - 0.0)
+        t = t + (warm if d > 0 else cool) * d
+        assert traj[i] == pytest.approx(t, abs=1e-3)
+    # Same settling temperature as unscaled: k_ex * cell / (k_ex + k_loss) = -8.
+    assert traj[-1] == pytest.approx(-8.0, abs=1e-2)
+
+
+def test_warming_and_cooling_speeds_differ_by_direction():
+    # From the setpoint into a cold cell d < 0 the whole way (cooling scale only);
+    # from far below the fixed point d > 0 the whole way (warming scale only).
+    slow = _params(_config(cell_temp=-10.0, cooling_rate_scale=0.5, warming_rate_scale=2.0))
+    base = _params(_config(cell_temp=-10.0))
+    cooling_slow = _traj(slow, 10)[-1]
+    cooling_base = _traj(base, 10)[-1]
+    assert cooling_slow > cooling_base            # cooling is slower => less cold
+    warming_fast = _traj(slow, 10, start=-14.0)[-1]
+    warming_base = _traj(base, 10, start=-14.0)[-1]
+    assert warming_fast > warming_base            # warming is faster => warmer
