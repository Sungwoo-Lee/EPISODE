diff --git a/tests/env/test_thermal_rate_scale.py b/tests/env/test_thermal_rate_scale.py
new file mode 100644
index 0000000..6d1d75e
--- /dev/null
+++ b/tests/env/test_thermal_rate_scale.py
@@ -0,0 +1,191 @@
+"""Asymmetric body-temperature speed: `thermal.warming_rate_scale` / `cooling_rate_scale`.
+
+What this file checks, in plain terms: the body can now warm and cool at different
+speeds. Each step the recurrence produces a change d; the body moves by s*d, with s
+the warming scale when d > 0 and the cooling scale otherwise. Because the WHOLE step
+is scaled, the point where d = 0 does not move, so every settling temperature is the
+same as before — only how fast the body gets there changes.
+
+The dynamics are checked against a plain-Python re-statement of the rule, and the
+"settles at the same temperature" claim against the algebraic fixed point, which is
+not derived from `core.py`.
+"""
+import os
+
+# Backend pinning MUST precede any jax import (see the sibling thermal tests).
+os.environ.setdefault("JAX_PLATFORMS", "cpu")
+
+import copy
+import sys
+
+import numpy as np
+import pytest
+import yaml
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+_ROOT = os.path.abspath(os.path.join(_HERE, "..", ".."))
+sys.path.insert(0, _ROOT)
+
+import jax
+
+from src.utils.config import Config
+from src.environment.config_loader import load_env_params
+from src.environment.core import jax_reset, jax_step
+
+THERMAL_CONFIG = os.path.join(
+    _ROOT, "configs", "environment", "experiment", "archive", "thermal", "campfire_world.yaml")
+DEFAULT_CONFIG = os.path.join(_ROOT, "configs", "environment", "default.yaml")
+REST = 4
+
+
+def _uniform_field_config(cell_temp):
+    """Constant field, nothing that can end the episode for a non-thermal reason."""
+    d = copy.deepcopy(yaml.safe_load(open(THERMAL_CONFIG)))
+    d["thermal"]["use_object_sources"] = False
+    d["thermal"]["use_random_spots"] = False
+    d["thermal"]["default_temp"] = [float(cell_temp), float(cell_temp)]
+    d["environment"]["entities"] = []
+    d["environment"]["obstacles"] = [
+        o for o in d["environment"]["obstacles"] if o.get("name") == "campfire"]
+    d["environment"]["resources"] = [
+        r for r in d["environment"]["resources"] if r.get("type") == "food"]
+    d["environment"]["max_steps"] = 2000
+    d["body"]["metabolic_cost"] = 0.0
+    return d
+
+
+def _params(d):
+    return load_env_params(Config(d))
+
+
+def _traj(params, n, seed=0):
+    state = jax_reset(params, jax.random.PRNGKey(seed))
+    out = [float(state.body_temp)]
+    for _ in range(n):
+        state, _, done, _ = jax_step(state, REST, params)
+        out.append(float(state.body_temp))
+        assert not bool(done)
+    return np.array(out)
+
+
+def _oracle(cell, t0, n, warm, cool, k_ex=0.04, k_loss=0.01, k_met=0.0, t_set=0.0):
+    t, out = t0, [t0]
+    for _ in range(n):
+        d = k_ex * (cell - t) + k_met - k_loss * (t - t_set)
+        t = t + (warm if d > 0 else cool) * d
+        out.append(t)
+    return np.array(out)
+
+
+# ── shipped values ────────────────────────────────────────────────────────────
+
+@pytest.mark.parametrize("path", [THERMAL_CONFIG, DEFAULT_CONFIG])
+def test_shipped_configs_carry_unit_scales(path):
+    d = yaml.safe_load(open(path))
+    assert d["thermal"]["warming_rate_scale"] == 1.0
+    assert d["thermal"]["cooling_rate_scale"] == 1.0
+
+
+def test_params_expose_static_fields():
+    p = _params(_uniform_field_config(-10.0))
+    assert p.thermal_warming_rate_scale == 1.0
+    assert p.thermal_cooling_rate_scale == 1.0
+    # static = part of the treedef, not a leaf, so changing it changes the compiled step
+    q = p.replace(thermal_cooling_rate_scale=0.5)
+    assert jax.tree_util.tree_structure(p) != jax.tree_util.tree_structure(q)
+
+
+def test_thermal_off_load_needs_no_scale_keys():
+    d = yaml.safe_load(open(DEFAULT_CONFIG))
+    assert d["thermal"]["enabled"] is False
+    del d["thermal"]["warming_rate_scale"], d["thermal"]["cooling_rate_scale"]
+    p = _params(d)
+    assert (p.thermal_warming_rate_scale, p.thermal_cooling_rate_scale) == (1.0, 1.0)
+
+
+# ── load-time validation ──────────────────────────────────────────────────────
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+def test_missing_key_is_refused(key):
+    d = _uniform_field_config(-10.0)
+    del d["thermal"][key]
+    with pytest.raises(ValueError, match=key):
+        _params(d)
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+@pytest.mark.parametrize("bad", [0.0, -1.0, float("nan")])
+def test_non_positive_or_nan_is_refused(key, bad):
+    d = _uniform_field_config(-10.0)
+    d["thermal"][key] = bad
+    with pytest.raises(ValueError, match=rf"thermal\.{key} must be > 0"):
+        _params(d)
+
+
+@pytest.mark.parametrize("key", ["warming_rate_scale", "cooling_rate_scale"])
+def test_monotone_bound_is_refused_and_boundary_accepted(key):
+    d = _uniform_field_config(-10.0)     # k_exchange + k_loss = 0.05 -> bound 20
+    d["thermal"][key] = 20.5
+    with pytest.raises(ValueError, match=rf"thermal\.{key} \* .*<= 1"):
+        _params(d)
+    d["thermal"][key] = 16.0             # 16 * 0.05 = 0.8, exactly representable margin
+    _params(d)
+
+
+def test_unscaled_stability_check_kept():
+    d = _uniform_field_config(-10.0)
+    d["thermal"]["k_exchange"] = 0.9
+    d["thermal"]["k_loss"] = 0.2
+    with pytest.raises(ValueError, match=r"thermal\.k_exchange \+ thermal\.k_loss must be <= 1"):
+        _params(d)
+
+
+# ── dynamics ──────────────────────────────────────────────────────────────────
+
+def test_unit_scales_are_todays_recurrence():
+    p = _params(_uniform_field_config(-10.0))
+    traj = _traj(p, 60)
+    np.testing.assert_allclose(traj, _oracle(-10.0, traj[0], 60, 1.0, 1.0), atol=2e-4)
+
+
+def test_cooling_scale_slows_cooling_and_same_settling_point():
+    d = _uniform_field_config(-10.0)
+    d["thermal"]["cooling_rate_scale"] = 0.5
+    traj = _traj(_params(d), 800)
+    np.testing.assert_allclose(traj[:100], _oracle(-10.0, traj[0], 100, 1.0, 0.5)[:100],
+                               atol=2e-4)
+    assert traj[-1] == pytest.approx(-8.0, abs=1e-3)       # T* = k_ex*T_f/(k_ex+k_loss)
+    base = _traj(_params(_uniform_field_config(-10.0)), 20)
+    assert traj[20] > base[20]                              # slower -> less cold at step 20
+
+
+def test_scale_applies_by_sign_of_d():
+    # Warming scale must not touch a cooling step, and vice versa.
+    d = _uniform_field_config(-10.0)
+    d["thermal"]["warming_rate_scale"] = 0.25
+    cold = _traj(_params(d), 40)
+    np.testing.assert_allclose(cold, _oracle(-10.0, cold[0], 40, 0.25, 1.0), atol=2e-4)
+    base = _traj(_params(_uniform_field_config(-10.0)), 40)
+    np.testing.assert_allclose(cold, base, atol=2e-4)       # every step was cooling
+
+    d = _uniform_field_config(10.0)
+    d["thermal"]["warming_rate_scale"] = 0.5
+    d["thermal"]["cooling_rate_scale"] = 3.0
+    hot = _traj(_params(d), 800)
+    np.testing.assert_allclose(hot[:100], _oracle(10.0, hot[0], 100, 0.5, 3.0)[:100], atol=2e-4)
+    assert hot[-1] == pytest.approx(8.0, abs=1e-3)
+
+
+def test_static_branch_keeps_unit_path_out_of_the_graph():
+    def n_eqns(warm, cool):
+        d = _uniform_field_config(-10.0)
+        d["thermal"]["warming_rate_scale"] = warm
+        d["thermal"]["cooling_rate_scale"] = cool
+        p = _params(d)
+        s = jax_reset(p, jax.random.PRNGKey(0))
+        # jax_step is jitted, so the body lives in a nested jaxpr: count via its text
+        return len(str(jax.make_jaxpr(lambda st: jax_step(st, REST, p))(s)).splitlines())
+
+    unit, scaled = n_eqns(1.0, 1.0), n_eqns(1.0, 0.5)
+    assert scaled > unit
+    assert n_eqns(0.5, 0.5) == scaled     # equal non-unit values are a uniform speed change
