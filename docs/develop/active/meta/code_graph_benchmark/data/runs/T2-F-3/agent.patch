diff --git a/tests/models/test_return_mode.py b/tests/models/test_return_mode.py
new file mode 100644
index 0000000..ba012c8
--- /dev/null
+++ b/tests/models/test_return_mode.py
@@ -0,0 +1,51 @@
+"""Tests for the recurrent-PPO return-mode validator and the MC_FIXED mode.
+
+Plain-language context: recurrent PPO turns a rollout into learning signals ("returns")
+in one of three ways: "MC" (Monte-Carlo returns, normalised and used as the critic
+target), "GAE" (generalised advantage estimation), and "MC_FIXED" (the same Monte-Carlo
+returns as MC, but with GAE's bookkeeping: raw returns are the critic target and the
+advantages are normalised like GAE's). A mistyped mode must fail loudly, up front, and
+the plain (non-recurrent) PPO trainer must refuse MC_FIXED rather than quietly running GAE.
+"""
+from types import SimpleNamespace
+
+import pytest
+
+from src.models import ppo_trainer, recurrent_ppo_trainer
+from src.models.recurrent_ppo_trainer import validate_return_mode
+
+
+@pytest.mark.parametrize("raw, canonical", [
+    ("MC", "MC"), ("mc", "MC"), ("Mc", "MC"),
+    ("MC_FIXED", "MC_FIXED"), ("mc_fixed", "MC_FIXED"), ("  Mc_Fixed\n", "MC_FIXED"),
+    ("GAE", "GAE"), ("gae", "GAE"), (" gae ", "GAE"),
+])
+def test_validate_return_mode_accepts_and_canonicalises(raw, canonical):
+    assert validate_return_mode(raw) == canonical
+
+
+@pytest.mark.parametrize("bad", ["", "  ", "MCFIXED", "MC-FIXED", "mc fixed", "TD", "GAE_FIXED", None, 1])
+def test_validate_return_mode_rejects_with_all_legal_modes_named(bad):
+    with pytest.raises(ValueError) as exc:
+        validate_return_mode(bad)
+    for mode in ("MC", "MC_FIXED", "GAE"):
+        assert mode in str(exc.value)
+
+
+def test_recurrent_train_iteration_rejects_invalid_mode():
+    """Validation happens before any model/env use, so placeholders suffice."""
+    config = SimpleNamespace(rnn_type="GRU", return_mode="MC_FIXD")
+    with pytest.raises(ValueError, match="MC_FIXED"):
+        recurrent_ppo_trainer.train_iteration(None, None, None, None, None, None, config)
+
+
+def test_recurrent_collect_rejects_invalid_mode():
+    with pytest.raises(ValueError, match="MC_FIXED"):
+        recurrent_ppo_trainer.collect_trajectories(None, None, None, None, None, 1, return_mode="bogus")
+
+
+@pytest.mark.parametrize("mode", ["MC_FIXED", "mc_fixed", " Mc_Fixed "])
+def test_plain_ppo_rejects_mc_fixed(mode):
+    config = SimpleNamespace(return_mode=mode)
+    with pytest.raises(ValueError, match="MC_FIXED"):
+        ppo_trainer.train_iteration_ppo(None, None, None, None, None, config)
