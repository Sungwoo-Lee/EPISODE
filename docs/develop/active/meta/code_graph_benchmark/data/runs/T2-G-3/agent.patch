diff --git a/tests/models/test_return_mode_mc_fixed.py b/tests/models/test_return_mode_mc_fixed.py
new file mode 100644
index 0000000..87abff4
--- /dev/null
+++ b/tests/models/test_return_mode_mc_fixed.py
@@ -0,0 +1,131 @@
+"""MC_FIXED return mode: MC returns + GAE-branch bookkeeping (raw critic target, normalised advantages).
+
+Also pins `validate_return_mode`, the `use_gae_bootstrap` gating and the plain-PPO rejection.
+`train_iteration` is driven with synthetic trajectories (collect/update stubbed) so the batch it
+builds can be inspected directly.
+"""
+from types import SimpleNamespace
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+import pytest
+
+from src.models import recurrent_ppo_trainer as rt
+from src.models.recurrent_ppo_trainer import (
+    Transition, StepInfo, compute_gae, compute_mc_returns, validate_return_mode,
+)
+
+T, N = 6, 3
+GAMMA = 0.97
+
+
+def _trajectories():
+    k = jax.random.split(jax.random.PRNGKey(0), 4)
+    reward = jax.random.normal(k[0], (T, N))
+    value = jax.random.normal(k[1], (T, N))
+    next_value = jax.random.normal(k[2], (T, N))
+    done = jnp.zeros((T, N), bool).at[2, 0].set(True).at[T - 1, 1].set(True).at[3, 2].set(True)
+    term = jnp.zeros((T, N), jnp.int32).at[2, 0].set(1).at[T - 1, 1].set(2).at[3, 2].set(3)
+    step_info = SimpleNamespace(termination_reason=term)
+    return SimpleNamespace(
+        obs=jnp.zeros((T, N, 2)), action=jnp.zeros((T, N), jnp.int32), reward=reward, done=done,
+        log_prob=jnp.zeros((T, N)), value=value, mod_info=None, step_info=step_info,
+        next_value=next_value,
+    )
+
+
+def _run(monkeypatch, mode):
+    traj = _trajectories()
+    boot = jnp.array([0.5, -1.0, 2.0])
+    h_states = jnp.zeros((T, N, 4))
+    seen = {}
+
+    def fake_collect(*a, **kw):
+        seen["return_mode"] = kw["return_mode"]
+        return traj, h_states, "env", "h", "key", boot
+
+    def fake_update(model, optimizer, batch, config):
+        seen["batch"] = batch
+        return 0.0, ()
+
+    monkeypatch.setattr(rt, "collect_trajectories", fake_collect)
+    monkeypatch.setattr(rt, "update_step", fake_update)
+    cfg = SimpleNamespace(rnn_type="LSTM", return_mode=mode, num_steps=T, num_epochs=1,
+                          gamma=GAMMA, gae_lambda=0.9)
+    rt.train_iteration(None, None, None, "env", "h", "key", cfg)
+    return traj, boot, seen
+
+
+def _mc_returns(traj, boot):
+    terminateds = (traj.step_info.termination_reason >= 2).astype(traj.done.dtype)
+    return jax.vmap(compute_mc_returns, in_axes=(1, 1, 1, 0, None), out_axes=1)(
+        traj.reward, traj.done, terminateds, boot, GAMMA)
+
+
+def test_mc_fixed_uses_raw_targets_and_gae_style_advantage_norm(monkeypatch):
+    traj, boot, seen = _run(monkeypatch, "MC_FIXED")
+    returns = _mc_returns(traj, boot)
+    adv = returns - traj.value
+    expected_adv = (adv - jnp.mean(adv)) / (jnp.std(adv) + 1e-8)
+    np.testing.assert_array_equal(np.asarray(seen["batch"].targets), np.asarray(returns))
+    np.testing.assert_array_equal(np.asarray(seen["batch"].advantages), np.asarray(expected_adv))
+
+
+def test_mc_unchanged(monkeypatch):
+    traj, boot, seen = _run(monkeypatch, "MC")
+    returns = _mc_returns(traj, boot)
+    returns = (returns - jnp.mean(returns)) / (jnp.std(returns) + 1e-7)
+    np.testing.assert_array_equal(np.asarray(seen["batch"].targets), np.asarray(returns))
+    np.testing.assert_array_equal(np.asarray(seen["batch"].advantages),
+                                  np.asarray(returns - traj.value))
+
+
+def test_gae_unchanged(monkeypatch):
+    traj, _, seen = _run(monkeypatch, "GAE")
+    terminateds = (traj.step_info.termination_reason >= 2).astype(traj.done.dtype)
+    adv = jax.vmap(compute_gae, in_axes=(1, 1, 1, 1, 1, None, None), out_axes=1)(
+        traj.reward, traj.value, traj.next_value, traj.done, terminateds, GAMMA, 0.9)
+    np.testing.assert_array_equal(np.asarray(seen["batch"].targets), np.asarray(adv + traj.value))
+    expected = (adv - jnp.mean(adv)) / (jnp.std(adv) + 1e-8)
+    np.testing.assert_array_equal(np.asarray(seen["batch"].advantages), np.asarray(expected))
+
+
+def test_train_iteration_canonicalises_mode(monkeypatch):
+    _, _, seen = _run(monkeypatch, "  mc_fixed ")
+    assert seen["return_mode"] == "MC_FIXED"
+
+
+@pytest.mark.parametrize("raw,canon", [
+    ("MC", "MC"), ("mc", "MC"), (" Mc_Fixed\n", "MC_FIXED"), ("mc_fixed", "MC_FIXED"),
+    ("gae", "GAE"), ("GAE", "GAE"),
+])
+def test_validate_accepts(raw, canon):
+    assert validate_return_mode(raw) == canon
+
+
+@pytest.mark.parametrize("bad", ["", "MC-FIXED", "MCFIXED", "gae2", "FIXED", None, 1])
+def test_validate_rejects_and_names_all_modes(bad):
+    with pytest.raises(ValueError) as e:
+        validate_return_mode(bad)
+    for name in ("MC", "MC_FIXED", "GAE"):
+        assert name in str(e.value)
+
+
+def test_train_iteration_rejects_invalid_mode(monkeypatch):
+    with pytest.raises(ValueError, match="MC_FIXED"):
+        _run(monkeypatch, "MC_FIXD")
+
+
+def test_mc_fixed_keeps_mc_bootstrap_path():
+    """MC_FIXED must use the single window-edge forward (MC path), not GAE's per-step pass."""
+    import inspect
+    src = inspect.getsource(rt.collect_trajectories)
+    assert 'validate_return_mode(return_mode) == "GAE"' in src
+
+
+def test_plain_ppo_rejects_mc_fixed():
+    from src.models.ppo_trainer import train_iteration_ppo
+    cfg = SimpleNamespace(return_mode="MC_FIXED")
+    with pytest.raises(ValueError, match="MC_FIXED"):
+        train_iteration_ppo(None, None, None, None, None, cfg)
